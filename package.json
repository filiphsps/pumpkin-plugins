{
    "name": "pumpkin-plugins",
    "private": true,
    "description": "Pumpkin plugins written in TypeScript",
    "license": "MIT",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git"
    },
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "scripts": {
        "gen": "turbo gen plugin",
        "gen:action": "turbo gen action",
        "lint": "biome check . && eslint .",
        "lint:fix": "biome check --write . && eslint --fix .",
        "lint:commits": "commitlint --from HEAD~1",
        "build": "turbo run build",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "coverage": "turbo run test:coverage && pnpm exec c8 --reporter=lcov --reporter=text --reports-dir=coverage/actions node --test actions/*/src/*.test.mjs",
        "dev": "node scripts/dev.mjs",
        "test:scripts": "node --test scripts/*.test.mjs .agents/hooks/*.test.mjs",
        "test:integration": "turbo run test:integration --concurrency=4",
        "readme": "turbo run readme && node scripts/sync-action-readmes.mjs && pumpkin-plugins-docs root",
        "readme:check": "turbo run readme:check && node scripts/sync-action-readmes.mjs --check && pumpkin-plugins-docs root --check",
        "dev:docs": "pnpm run docs:api && vitepress dev docs",
        "docs": "pnpm run docs:build",
        "docs:build": "pnpm run docs:api && pnpm run docs:site",
        "docs:site": "vitepress build docs",
        "docs:api": "pnpm run docs:types && node scripts/generate-api-references.mjs",
        "docs:types": "concurrently --kill-others-on-fail --success all \"pnpm:docs:types:plugin-kit\" \"pnpm:docs:types:update-check\" && pnpm run docs:types:plugins",
        "docs:types:plugin-kit": "pnpm --filter @pumpkin-plugins/plugin-kit typecheck",
        "docs:types:update-check": "pnpm --filter @pumpkin-plugins/update-check typecheck",
        "docs:types:plugins": "pnpm --filter './packages/*' --parallel run types",
        "docs:preview": "vitepress preview docs",
        "check": "node scripts/check-release-config.mjs && node scripts/package-metadata.mjs && node scripts/check-docs.mjs",
        "package": "turbo run build && node scripts/collect-plugins.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@commitlint/config-conventional": "21.2.3",
        "c8": "catalog:",
        "@pumpkin-plugins/docs": "workspace:*",
        "@pumpkin-plugins/signing": "workspace:*",
        "@turbo/gen": "2.11.7",
        "commitlint": "21.2.3",
        "concurrently": "10.0.5",
        "eslint": "10.12.0",
        "eslint-plugin-jsdoc": "65.1.0",
        "turbo": "2.11.7",
        "typedoc": "0.28.20",
        "typedoc-plugin-markdown": "4.13.1",
        "typedoc-vitepress-theme": "1.1.4",
        "typescript": "catalog:",
        "typescript-eslint": "8.71.1",
        "vitepress": "1.6.4",
        "yaml": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.9.1"
        }
    }
}
