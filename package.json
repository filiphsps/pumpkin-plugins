{
    "name": "pumpkin-plugins",
    "private": true,
    "description": "pumpkin-plugins written in TypeScript",
    "homepage": "https://github.com/filiphsps/pumpkin-plugins",
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "license": "MIT",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "scripts": {
        "build": "node scripts/build.mjs",
        "build:parse-ts": "node scripts/build.mjs --parse-ts",
        "check": "node scripts/check-release-config.mjs && node scripts/package-metadata.mjs && node scripts/check-docs.mjs",
        "clean": "pnpm purge && node scripts/clean.mjs",
        "coverage": "pnpm turbo run test:coverage && pnpm exec c8 --reporter=lcov --reporter=text --reports-dir=coverage/actions node --test actions/*/src/*.test.mjs",
        "dev": "node scripts/dev.mjs",
        "dev:docs": "pnpm run docs:api && vitepress dev docs",
        "dev:nightly": "node scripts/dev.mjs --nightly",
        "dev:nightly:no-hot-reload": "node scripts/dev.mjs --nightly --no-hot-reload",
        "dev:no-hot-reload": "node scripts/dev.mjs --no-hot-reload",
        "docs": "pnpm run docs:build",
        "docs:api": "pnpm run docs:types && node scripts/generate-api-references.mjs",
        "docs:build": "pnpm run docs:api && pnpm run docs:site",
        "docs:preview": "vitepress preview docs",
        "docs:site": "vitepress build docs",
        "docs:types": "concurrently --kill-others-on-fail --success all \"pnpm:docs:types:plugin-kit\" \"pnpm:docs:types:update-check\" \"pnpm:docs:types:pumpkin-api\" \"pnpm:docs:types:codemod\" && pnpm run docs:types:plugins",
        "docs:types:codemod": "pnpm --filter @pumpkin-plugins/codemod typecheck",
        "docs:types:plugin-kit": "pnpm --filter @pumpkin-plugins/plugin-kit typecheck",
        "docs:types:plugins": "pnpm --filter './packages/*' --parallel run types",
        "docs:types:pumpkin-api": "pnpm --filter @pumpkin-plugins/pumpkin-api typecheck",
        "docs:types:update-check": "pnpm --filter @pumpkin-plugins/update-check typecheck",
        "fix": "node scripts/check-release-config.mjs && node scripts/package-metadata.mjs --fix && pnpm readme && node scripts/check-docs.mjs && pnpm lint:fix",
        "gen": "pnpm turbo gen plugin",
        "gen:action": "pnpm turbo gen action",
        "gen:extension": "pnpm turbo gen extension",
        "lint": "biome check --reporter=concise . || biome check . && eslint .",
        "lint:actions": "actionlint -color",
        "lint:commits": "commitlint --from HEAD~1",
        "lint:fix": "biome check --reporter=concise --write --unsafe . && eslint --fix .",
        "npm:bootstrap": "node scripts/npm-bootstrap.mjs",
        "package": "node scripts/package-plugins.mjs",
        "readme": "pnpm turbo run readme && pumpkin-plugins-docs actions && pumpkin-plugins-docs root && pumpkin-plugins-docs generate scripts/pinned-pumpkin-links.mjs",
        "readme:check": "pnpm turbo run readme:check && pumpkin-plugins-docs actions --check && pumpkin-plugins-docs root --check && pumpkin-plugins-docs generate scripts/pinned-pumpkin-links.mjs --check",
        "register:tool": "node scripts/register-public-tool.mjs",
        "test": "pnpm turbo run test",
        "test:external-consumer": "node scripts/test-external-consumer.mjs",
        "test:integration": "pnpm turbo run test:integration --concurrency=4",
        "test:scripts": "node --test scripts/*.test.mjs scripts/utils/*.test.mjs .agents/hooks/*.test.mjs",
        "turbo": "node scripts/turbo.mjs",
        "typecheck": "pnpm turbo run typecheck"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@commitlint/config-conventional": "21.2.3",
        "@pumpkin-plugins/docs": "workspace:*",
        "@pumpkin-plugins/signing": "workspace:*",
        "@pumpkin-plugins/static-hermes-runtime": "workspace:*",
        "@turbo/gen": "2.11.7",
        "c8": "catalog:",
        "commander": "catalog:",
        "commitlint": "21.2.3",
        "concurrently": "10.0.6",
        "eslint": "10.12.0",
        "eslint-plugin-jsdoc": "65.1.0",
        "tsc-rs": "catalog:",
        "turbo": "2.11.8",
        "typedoc": "0.28.20",
        "typedoc-plugin-markdown": "4.13.1",
        "typedoc-vitepress-theme": "1.1.4",
        "typescript": "catalog:",
        "typescript-eslint": "8.71.1",
        "vitepress": "2.0.0-alpha.20",
        "yaml": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.11.2"
        }
    }
}
