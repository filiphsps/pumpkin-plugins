{
    "name": "@pumpkin-plugins/bedrock-addon-manager",
    "version": "0.0.0",
    "private": true,
    "description": "Hosts Bedrock packs over HTTP and exports their pumpkin.toml entries",
    "keywords": [
        "minecraft",
        "pumpkin",
        "plugin",
        "bedrock",
        "addon",
        "resource-pack",
        "mcpack",
        "mcaddon",
        "http"
    ],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins/tree/master/packages/bedrock-addon-manager#readme",
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git",
        "directory": "packages/bedrock-addon-manager"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "license": "MIT",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "type": "module",
    "scripts": {
        "build": "pumpkin-plugins-build",
        "build:parse-ts": "pumpkin-plugins-build --parse-ts",
        "readme": "pumpkin-plugins-docs",
        "readme:check": "pumpkin-plugins-docs --check",
        "test": "vitest run --project unit",
        "test:coverage": "vitest run --project unit --coverage",
        "test:integration": "vitest run --project integration",
        "typecheck": "pnpm types && tsc --noEmit",
        "types": "pumpkin-plugins-build --types-only"
    },
    "dependencies": {
        "@pumpkin-plugins/config": "workspace:*",
        "@pumpkin-plugins/docs": "workspace:*",
        "@pumpkin-plugins/minecraft-colors": "workspace:*",
        "@pumpkin-plugins/plugin-kit": "workspace:*",
        "@pumpkin-plugins/port-mapping": "workspace:*",
        "@pumpkin-plugins/pumpkin-api": "catalog:",
        "@pumpkin-plugins/upnpumpkin-api": "workspace:*",
        "fflate": "catalog:"
    },
    "devDependencies": {
        "@pumpkin-plugins/build": "workspace:*",
        "@pumpkin-plugins/test-harness": "workspace:*",
        "@pumpkin-plugins/upnpumpkin": "workspace:*",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "smol-toml": "1.9.0",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "pumpkinPlugin": {
        "entry": "src/plugin.ts",
        "output": "build/bedrock-addon-manager.wasm",
        "wasi": [
            "filesystem",
            "sockets",
            "http"
        ]
    }
}
