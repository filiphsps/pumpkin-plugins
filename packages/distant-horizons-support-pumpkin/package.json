{
    "name": "@pumpkin-plugins/distant-horizons-support-pumpkin",
    "version": "0.1.2",
    "private": true,
    "description": "Unofficial Distant Horizons server support for Pumpkin",
    "keywords": [
        "minecraft",
        "pumpkin",
        "plugin",
        "distant-horizons",
        "lod",
        "server"
    ],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins/tree/master/packages/distant-horizons-support-pumpkin#readme",
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git",
        "directory": "packages/distant-horizons-support-pumpkin"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "license": "GPL-3.0-or-later",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "type": "module",
    "scripts": {
        "build": "pumpkin-plugins-build",
        "build:parse-ts": "pumpkin-plugins-build --parse-ts",
        "readme": "pumpkin-plugins-docs && pumpkin-plugins-docs generate docs.ts",
        "readme:check": "pumpkin-plugins-docs --check && pumpkin-plugins-docs generate docs.ts --check",
        "test": "vitest run --project unit",
        "test:coverage": "vitest run --project unit --coverage",
        "test:integration": "vitest run --project integration",
        "typecheck": "pnpm types && tsc --noEmit",
        "types": "pumpkin-plugins-build --types-only"
    },
    "dependencies": {
        "@pumpkin-plugins/config": "workspace:*",
        "@pumpkin-plugins/docs": "workspace:*",
        "@pumpkin-plugins/minecraft-colors": "workspace:*",
        "@pumpkin-plugins/plugin-kit": "workspace:*",
        "@pumpkin-plugins/pumpkin-api": "catalog:",
        "@pumpkin-plugins/pumpkin-pie-api": "catalog:",
        "@pumpkin-plugins/terrain": "workspace:*",
        "pretty-bytes": "7.2.0"
    },
    "devDependencies": {
        "@pumpkin-plugins/build": "workspace:*",
        "@pumpkin-plugins/test-harness": "workspace:*",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "pumpkinPlugin": {
        "entry": "src/plugin.ts",
        "engine": "static-hermes",
        "output": "build/distant-horizons-support-pumpkin.wasm",
        "wasi": [
            "filesystem",
            "http"
        ]
    }
}
