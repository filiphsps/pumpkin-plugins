{
    "name": "@pumpkin-plugins/engine-comparison",
    "version": "0.0.0",
    "private": true,
    "description": "Compares plugin engines on a real Pumpkin server",
    "type": "module",
    "scripts": {
        "typecheck": "pnpm types && tsc --noEmit",
        "types": "node ../../tools/pumpkin-api/scripts/gen-types.mjs build/types",
        "test": "vitest run test/engine-comparison-report.test.ts test/engine-variants.test.ts test/benchmark-workloads.test.ts",
        "compare-engines": "vitest run test/engine-comparison.test.ts"
    },
    "devDependencies": {
        "@bytecodealliance/jco": "catalog:",
        "@pumpkin-plugins/build": "workspace:*",
        "@pumpkin-plugins/static-hermes-runtime": "workspace:*",
        "@pumpkin-plugins/test-harness": "workspace:*",
        "@pumpkin-plugins/pumpkin-api": "catalog:",
        "@types/node": "catalog:",
        "vitest": "catalog:"
    }
}
