{
    "actionlint.enable": true,
    "biome.requireConfiguration": true,
    "cSpell.words": [
        "appleskin",
        "barebones",
        "blocklist",
        "catchable",
        "CGNAT",
        "clientbound",
        "codegen",
        "codemod",
        "codemods",
        "commitlint",
        "componentizer",
        "compostable",
        "datagrams",
        "despawn",
        "dynamiclights",
        "enchantable",
        "equippable",
        "fflate",
        "frontmatter",
        "gamemode",
        "heightmap",
        "itest",
        "llms",
        "lockfiles",
        "mcaddon",
        "mcpack",
        "mooshroom",
        "mspt",
        "nethernet",
        "nojekyll",
        "outgoingdatagram",
        "overworld",
        "pollable",
        "pumpkinmc",
        "rcode",
        "shermes",
        "smol",
        "Speedport",
        "SSDP",
        "strikethrough",
        "syscalls",
        "Turborepo",
        "typechecks",
        "typedoc",
        "unmatch",
        "upnp",
        "upnpumpkin",
        "vitepress",
        "vitest",
        "WASI",
        "Wasmtime",
        "worktree",
        "Xaero's"
    ],
    "editor.formatOnPaste": false,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.renderLineHighlight": "all",
    "editor.renderWhitespace": "all",
    "explorer.decorations.badges": true,
    "explorer.decorations.colors": true,
    "files.insertFinalNewline": true,
    "git.autofetch": "all",
    "git.decorations.enabled": true,
    "git.ignoreMissingGitWarning": false,
    "git.pullBeforeCheckout": true,
    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "text": "Use conventional commit message format."
        }
    ],
    "js/ts.experimental.useTsgo": true,
    "js/ts.suggest.jsdoc.enabled": true,
    "js/ts.suggestionActions.enabled": true,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "js/ts.updateImportsOnPaste.enabled": true,
    "json.schemas": [
        {
            "fileMatch": ["tools/pumpkin-api/compatibility/**/*.json"],
            "url": "https://raw.githubusercontent.com/filiphsps/pumpkin-plugins/master/schemas/pumpkin-api-compatibility.schema.json"
        },
        {
            "fileMatch": ["tools/pumpkin-api/wit.lock.json"],
            "url": "https://raw.githubusercontent.com/filiphsps/pumpkin-plugins/master/tools/pumpkin-api/schemas/upstream-git-pin.schema.json"
        },
        {
            "fileMatch": ["tools/static-hermes-runtime/hermes-source.lock.json"],
            "url": "https://raw.githubusercontent.com/filiphsps/pumpkin-plugins/master/schemas/upstream-git-pin.schema.json"
        },
        {
            "fileMatch": ["tools/static-hermes-runtime/wasi-sdk.lock.json"],
            "url": "https://raw.githubusercontent.com/filiphsps/pumpkin-plugins/master/schemas/wasi-sdk-release-pin.schema.json"
        },
        {
            "fileMatch": ["tools/static-hermes-runtime/toolchain-versions.json"],
            "url": "https://raw.githubusercontent.com/filiphsps/pumpkin-plugins/master/schemas/toolchain-versions.schema.json"
        }
    ],
    "notebook.defaultFormatter": "biomejs.biome",
    "notebook.output.wordWrap": true,
    "npm.packageManager": "pnpm",
    "npm.scriptRunner": "pnpm",
    "terminal.integrated.fontLigatures.enabled": true
}
