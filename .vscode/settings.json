{
    "[markdown]": {
        "editor.rulers": [80],
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 80
    },
    "actionlint.enable": true,
    "biome.requireConfiguration": true,
    "cSpell.words": [
        "appleskin",
        "barebones",
        "blocklist",
        "catchable",
        "CGNAT",
        "codegen",
        "codemod",
        "codemods",
        "commitlint",
        "componentizer",
        "datagrams",
        "dynamiclights",
        "fflate",
        "frontmatter",
        "itest",
        "llms",
        "lockfiles",
        "mattpocock",
        "mcaddon",
        "mcpack",
        "mspt",
        "nethernet",
        "nojekyll",
        "outgoingdatagram",
        "pocock",
        "pollable",
        "pumpkinmc",
        "rcode",
        "shermes",
        "smol",
        "Speedport",
        "SSDP",
        "strikethrough",
        "syscalls",
        "Turborepo",
        "typechecks",
        "typedoc",
        "unmatch",
        "upnp",
        "upnpumpkin",
        "vitepress",
        "vitest",
        "WASI",
        "Wasmtime",
        "worktree",
        "worktrees",
        "Xaero's"
    ],
    "editor.formatOnPaste": false,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.renderLineHighlight": "all",
    "editor.renderWhitespace": "all",
    "explorer.decorations.badges": true,
    "explorer.decorations.colors": true,
    "files.insertFinalNewline": true,
    "git.autofetch": "all",
    "git.decorations.enabled": true,
    "git.ignoreMissingGitWarning": false,
    "git.pullBeforeCheckout": true,
    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "text": "Use conventional commit message format."
        }
    ],
    "js/ts.experimental.useTsgo": true,
    "js/ts.suggest.jsdoc.enabled": true,
    "js/ts.suggestionActions.enabled": true,
    "js/ts.tsdk.additionalLocations": [
        "node_modules/.pnpm/node_modules/@tsc-rs/darwin-arm64/lib",
        "node_modules/.pnpm/node_modules/@tsc-rs/darwin-x64/lib",
        "node_modules/.pnpm/node_modules/@tsc-rs/linux-arm64/lib",
        "node_modules/.pnpm/node_modules/@tsc-rs/linux-x64/lib",
        "node_modules/.pnpm/node_modules/@tsc-rs/win32-x64/lib",
        "node_modules/.pnpm/node_modules/@tsc-rs/win32-arm64/lib"
    ],
    "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "js/ts.updateImportsOnPaste.enabled": true,
    "notebook.defaultFormatter": "biomejs.biome",
    "notebook.output.wordWrap": true,
    "npm.packageManager": "pnpm",
    "npm.scriptRunner": "pnpm",
    "terminal.integrated.fontLigatures.enabled": true
}
