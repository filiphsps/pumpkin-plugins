{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/filiphsps/pumpkin-plugins/master/schemas/toolchain-versions.schema.json",
    "title": "Toolchain versions",
    "description": "Version pins keyed by the names of tools required for a build.",
    "type": "object",
    "additionalProperties": false,
    "required": ["tools"],
    "properties": {
        "$schema": {
            "type": "string",
            "format": "uri-reference",
            "const": "https://raw.githubusercontent.com/filiphsps/pumpkin-plugins/master/schemas/toolchain-versions.schema.json",
            "minLength": 1
        },
        "tools": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "additionalProperties": {
                "type": "string",
                "minLength": 1
            }
        }
    }
}
