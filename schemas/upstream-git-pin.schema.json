{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/filiphsps/pumpkin-plugins/schemas/upstream-git-pin.schema.json",
    "title": "Upstream Git pin",
    "description": "A Git repository branch pinned to an immutable Git object ID.",
    "type": "object",
    "additionalProperties": false,
    "required": ["repository", "branch", "commit"],
    "properties": {
        "$schema": {
            "type": "string",
            "format": "uri-reference",
            "minLength": 1
        },
        "repository": {
            "type": "string",
            "format": "uri",
            "minLength": 1
        },
        "branch": {
            "type": "string",
            "minLength": 1
        },
        "commit": {
            "type": "string",
            "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$",
            "description": "A SHA-1 or SHA-256 Git object ID."
        }
    }
}
