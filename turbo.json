{
    "$schema": "https://v2-11-9.turborepo.dev/schema.json",
    "agentGuidance": false,
    "globalDependencies": [".node-version", "pnpm-workspace.yaml", "tsconfig.base.json"],
    "globalPassThroughEnv": [
        "PUMPKIN_BIN",
        "PUMPKIN_CACHE_DIR",
        "PUMPKIN_KEEP_DIR",
        "PUMPKIN_PLUGINS_CACHE_DIR",
        "PUMPKIN_TEST_LOG_DIR"
    ],
    "tasks": {
        "transit": {
            "dependsOn": ["^transit"]
        },
        "build": {
            "dependsOn": ["transit", "@pumpkin-plugins/build#build"],
            "env": [
                "PUMPKIN_DEV_MODE",
                "PUMPKIN_PLUGINS_FAIL_ON_SIZE_LIMIT",
                "PUMPKIN_PLUGINS_VERBOSE_BUILD",
                "STATIC_HERMES_*",
                "WASI_SDK_PATH",
                "WASI_SDK",
                "WIT_BINDGEN"
            ],
            "passThroughEnv": ["PUMPKIN_PLUGINS_STATIC_HERMES_PREPARED", "WASM_TOOLS"],
            "outputs": ["build/**", "!build/types/**", "dist/**"]
        },
        "build:parse-ts": {
            "dependsOn": ["transit", "@pumpkin-plugins/build#build"],
            "env": [
                "PUMPKIN_DEV_MODE",
                "PUMPKIN_PLUGINS_FAIL_ON_SIZE_LIMIT",
                "PUMPKIN_PLUGINS_VERBOSE_BUILD",
                "STATIC_HERMES_*",
                "WASI_SDK_PATH",
                "WASI_SDK",
                "WIT_BINDGEN"
            ],
            "passThroughEnv": ["PUMPKIN_PLUGINS_STATIC_HERMES_PREPARED", "WASM_TOOLS"],
            "outputs": ["build/**", "!build/types/**", "dist/**"]
        },
        "benchmark:build": {
            "dependsOn": ["transit", "@pumpkin-plugins/build#build"],
            "env": [
                "PUMPKIN_DEV_MODE",
                "PUMPKIN_PLUGINS_FAIL_ON_SIZE_LIMIT",
                "PUMPKIN_PLUGINS_VERBOSE_BUILD",
                "STATIC_HERMES_*",
                "ENGINE_COMPARISON_VARIANT",
                "WASI_SDK_PATH",
                "WASI_SDK",
                "WIT_BINDGEN"
            ],
            "passThroughEnv": ["PUMPKIN_PLUGINS_STATIC_HERMES_PREPARED", "WASM_TOOLS"],
            "outputs": ["build/engine-comparison/**"]
        },
        "@pumpkin-plugins/build#build": {
            "dependsOn": [
                "transit",
                "@pumpkin-plugins/static-hermes-runtime#build",
                "@pumpkin-plugins/wasi-capabilities#build"
            ],
            "outputs": ["dist/**"]
        },
        "@pumpkin-plugins/static-hermes-runtime#build": {
            "dependsOn": ["transit"],
            "outputs": ["dist/**"]
        },
        "typecheck": {
            "dependsOn": ["transit"]
        },
        "@pumpkin-plugins/build#typecheck": {
            "dependsOn": ["transit", "@pumpkin-plugins/static-hermes-runtime#build"]
        },
        "test": {
            "dependsOn": ["transit"]
        },
        "@pumpkin-plugins/build#test": {
            "dependsOn": [
                "transit",
                "@pumpkin-plugins/static-hermes-runtime#build",
                "@pumpkin-plugins/wasi-capabilities#build"
            ]
        },
        "@pumpkin-plugins/static-hermes-runtime#test": {
            "dependsOn": ["transit", "@pumpkin-plugins/wasi-capabilities#build"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/tools/build/src/errors.ts",
                "$TURBO_ROOT$/tools/build/src/repo.ts",
                "$TURBO_ROOT$/tools/build/src/wasi-wit-lock.ts",
                "$TURBO_ROOT$/tools/build/src/wasi-wit.ts",
                "$TURBO_ROOT$/tools/build/src/wit.ts",
                "$TURBO_ROOT$/tools/build/wasi-wit.lock.json"
            ],
            "outputs": ["dist/**"]
        },
        "@pumpkin-plugins/static-hermes-runtime#readme": {
            "dependsOn": ["@pumpkin-plugins/wasi-capabilities#build"],
            "cache": false
        },
        "@pumpkin-plugins/static-hermes-runtime#readme:check": {
            "dependsOn": ["@pumpkin-plugins/wasi-capabilities#build"],
            "cache": false
        },
        "test:coverage": {
            "dependsOn": ["transit"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/coverage.config.json", "$TURBO_ROOT$/scripts/coverage.mjs"],
            "passThroughEnv": ["NODE_V8_COVERAGE"],
            "outputs": ["coverage/**"]
        },
        "@pumpkin-plugins/build#test:coverage": {
            "dependsOn": [
                "transit",
                "@pumpkin-plugins/static-hermes-runtime#build",
                "@pumpkin-plugins/wasi-capabilities#build"
            ],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/coverage.config.json", "$TURBO_ROOT$/scripts/coverage.mjs"],
            "passThroughEnv": ["NODE_V8_COVERAGE"],
            "outputs": ["coverage/**"]
        },
        "test:integration": {
            "dependsOn": ["build", "@pumpkin-plugins/build#build"],
            "passThroughEnv": ["STATIC_HERMES_*", "WASI_SDK_PATH", "WASI_SDK", "WASM_TOOLS", "WIT_BINDGEN"],
            "cache": false
        },
        "readme": {
            "cache": false
        },
        "readme:check": {
            "cache": false
        }
    }
}
