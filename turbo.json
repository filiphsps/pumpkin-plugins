{
    "$schema": "https://v2-11-7.turborepo.dev/schema.json",
    "agentGuidance": false,
    "globalDependencies": [
        "pnpm-workspace.yaml",
        "tsconfig.base.json",
        "pumpkin-api-targets.json",
        "scripts/pumpkin-targets.mjs",
        "scripts/pumpkin-targets.d.mts"
    ],
    "globalPassThroughEnv": [
        "PUMPKIN_BIN",
        "PUMPKIN_CACHE_DIR",
        "PUMPKIN_KEEP_DIR",
        "PUMPKIN_PLUGINS_CACHE_DIR",
        "PUMPKIN_TEST_LOG_DIR"
    ],
    "tasks": {
        "transit": {
            "dependsOn": ["^transit"]
        },
        "build": {
            "dependsOn": ["transit"],
            "env": [
                "PUMPKIN_API_TARGET",
                "PUMPKIN_API_DIR",
                "PUMPKIN_API_ENTRY",
                "PUMPKIN_WIT_DIR",
                "PUMPKIN_API_REVISION",
                "PUMPKIN_WIT_REVISION",
                "PUMPKIN_DEV_MODE"
            ],
            "outputs": ["build/**", "!build/types/**"]
        },
        "typecheck": {
            "dependsOn": ["transit"],
            "env": [
                "PUMPKIN_API_TARGET",
                "PUMPKIN_API_DIR",
                "PUMPKIN_API_ENTRY",
                "PUMPKIN_WIT_DIR",
                "PUMPKIN_API_REVISION",
                "PUMPKIN_WIT_REVISION"
            ],
            "outputs": ["build/types/**"]
        },
        "test": {
            "dependsOn": ["transit"],
            "env": [
                "PUMPKIN_API_TARGET",
                "PUMPKIN_API_DIR",
                "PUMPKIN_API_ENTRY",
                "PUMPKIN_WIT_DIR",
                "PUMPKIN_API_REVISION",
                "PUMPKIN_WIT_REVISION"
            ]
        },
        "test:coverage": {
            "dependsOn": ["transit"],
            "outputs": ["coverage/**"],
            "env": [
                "PUMPKIN_API_TARGET",
                "PUMPKIN_API_DIR",
                "PUMPKIN_API_ENTRY",
                "PUMPKIN_WIT_DIR",
                "PUMPKIN_API_REVISION",
                "PUMPKIN_WIT_REVISION"
            ]
        },
        "test:integration": {
            "dependsOn": ["build"],
            "cache": false,
            "env": [
                "PUMPKIN_API_TARGET",
                "PUMPKIN_API_DIR",
                "PUMPKIN_API_ENTRY",
                "PUMPKIN_WIT_DIR",
                "PUMPKIN_API_REVISION",
                "PUMPKIN_WIT_REVISION"
            ]
        },
        "readme": {
            "cache": false
        },
        "readme:check": {
            "cache": false
        }
    }
}
