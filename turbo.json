{
    "$schema": "https://v2-11-8.turborepo.dev/schema.json",
    "agentGuidance": false,
    "globalDependencies": ["pnpm-workspace.yaml", "tsconfig.base.json"],
    "globalPassThroughEnv": [
        "PUMPKIN_BIN",
        "PUMPKIN_CACHE_DIR",
        "PUMPKIN_KEEP_DIR",
        "PUMPKIN_PLUGINS_CACHE_DIR",
        "PUMPKIN_TEST_LOG_DIR"
    ],
    "tasks": {
        "transit": {
            "dependsOn": ["^transit"]
        },
        "build": {
            "dependsOn": ["transit", "@pumpkin-plugins/build#build"],
            "env": [
                "PUMPKIN_DEV_MODE",
                "PUMPKIN_PLUGINS_VERBOSE_BUILD",
                "STATIC_HERMES_CACHE_DIR",
                "STATIC_HERMES_SOURCE_DIR",
                "STATIC_HERMES_HOST_BUILD_DIR",
                "STATIC_HERMES_WASI_BUILD_DIR",
                "STATIC_HERMES_WASI_SDK_PATH",
                "STATIC_HERMES_STACK_SIZE",
                "STATIC_HERMES_ENABLE_JSI_EXTENSIONS",
                "STATIC_HERMES_ENABLE_LEAN_ARCHIVE",
                "STATIC_HERMES_ENABLE_UNICODE_REGEXP_PROPERTY_ESCAPES",
                "WASI_SDK_PATH",
                "WASI_SDK",
                "WIT_BINDGEN"
            ],
            "passThroughEnv": ["PUMPKIN_PLUGINS_STATIC_HERMES_PREPARED", "WASM_TOOLS"],
            "outputs": ["build/**", "!build/types/**", "dist/**"]
        },
        "build:parse-ts": {
            "dependsOn": ["transit", "@pumpkin-plugins/build#build"],
            "env": [
                "PUMPKIN_DEV_MODE",
                "PUMPKIN_PLUGINS_VERBOSE_BUILD",
                "STATIC_HERMES_CACHE_DIR",
                "STATIC_HERMES_SOURCE_DIR",
                "STATIC_HERMES_HOST_BUILD_DIR",
                "STATIC_HERMES_WASI_BUILD_DIR",
                "STATIC_HERMES_WASI_SDK_PATH",
                "STATIC_HERMES_STACK_SIZE",
                "STATIC_HERMES_ENABLE_JSI_EXTENSIONS",
                "STATIC_HERMES_ENABLE_LEAN_ARCHIVE",
                "STATIC_HERMES_ENABLE_UNICODE_REGEXP_PROPERTY_ESCAPES",
                "WASI_SDK_PATH",
                "WASI_SDK",
                "WIT_BINDGEN"
            ],
            "passThroughEnv": ["PUMPKIN_PLUGINS_STATIC_HERMES_PREPARED", "WASM_TOOLS"],
            "outputs": ["build/**", "!build/types/**", "dist/**"]
        },
        "benchmark:build": {
            "dependsOn": ["transit", "@pumpkin-plugins/build#build"],
            "env": [
                "PUMPKIN_DEV_MODE",
                "PUMPKIN_PLUGINS_VERBOSE_BUILD",
                "STATIC_HERMES_CACHE_DIR",
                "STATIC_HERMES_SOURCE_DIR",
                "STATIC_HERMES_HOST_BUILD_DIR",
                "STATIC_HERMES_WASI_BUILD_DIR",
                "STATIC_HERMES_WASI_SDK_PATH",
                "STATIC_HERMES_STACK_SIZE",
                "STATIC_HERMES_ENABLE_JSI_EXTENSIONS",
                "STATIC_HERMES_ENABLE_LEAN_ARCHIVE",
                "STATIC_HERMES_ENABLE_UNICODE_REGEXP_PROPERTY_ESCAPES",
                "ENGINE_COMPARISON_VARIANT",
                "WASI_SDK_PATH",
                "WASI_SDK",
                "WIT_BINDGEN"
            ],
            "passThroughEnv": ["PUMPKIN_PLUGINS_STATIC_HERMES_PREPARED", "WASM_TOOLS"],
            "outputs": ["build/engine-comparison/**"],
            "cache": true
        },
        "@pumpkin-plugins/build#build": {
            "dependsOn": ["transit", "@pumpkin-plugins/static-hermes-runtime#build"],
            "outputs": ["dist/**"]
        },
        "@pumpkin-plugins/static-hermes-runtime#build": {
            "dependsOn": ["transit"],
            "outputs": ["dist/**"]
        },
        "typecheck": {
            "dependsOn": ["transit", "@pumpkin-plugins/build#build"],
            "outputs": ["build/types/**"]
        },
        "test": {
            "dependsOn": ["transit"]
        },
        "@pumpkin-plugins/build#test": {
            "dependsOn": ["transit", "@pumpkin-plugins/static-hermes-runtime#build"]
        },
        "@pumpkin-plugins/static-hermes-runtime#test": {
            "dependsOn": ["transit"],
            "outputs": ["dist/**"]
        },
        "test:coverage": {
            "dependsOn": ["transit"],
            "outputs": ["coverage/**"]
        },
        "@pumpkin-plugins/build#test:coverage": {
            "dependsOn": ["transit", "@pumpkin-plugins/static-hermes-runtime#build"],
            "outputs": ["coverage/**"]
        },
        "test:integration": {
            "dependsOn": ["build", "@pumpkin-plugins/build#build"],
            "passThroughEnv": [
                "STATIC_HERMES_CACHE_DIR",
                "STATIC_HERMES_SOURCE_DIR",
                "STATIC_HERMES_HOST_BUILD_DIR",
                "STATIC_HERMES_WASI_BUILD_DIR",
                "STATIC_HERMES_WASI_SDK_PATH",
                "STATIC_HERMES_STACK_SIZE",
                "STATIC_HERMES_ENABLE_JSI_EXTENSIONS",
                "STATIC_HERMES_ENABLE_LEAN_ARCHIVE",
                "STATIC_HERMES_ENABLE_UNICODE_REGEXP_PROPERTY_ESCAPES",
                "WASI_SDK_PATH",
                "WASI_SDK",
                "WASM_TOOLS",
                "WIT_BINDGEN"
            ],
            "cache": false
        },
        "readme": {
            "cache": false
        },
        "readme:check": {
            "cache": false
        }
    }
}
