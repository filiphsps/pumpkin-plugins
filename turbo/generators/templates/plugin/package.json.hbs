{
    "name": "@pumpkin-plugins/{{ name }}",
    "version": "0.0.0",
    "private": true,
    "description": {{{ json description }}},
    "funding": {{{ json rootPackage.funding }}},
    "author": {{{ json rootPackage.author }}},
    "contributors": {{{ json rootPackage.contributors }}},
    "type": "module",
    "scripts": {
        "build": "pumpkin-plugins-build",
        "build:parse-ts": "pumpkin-plugins-build --parse-ts",
        "readme": "pumpkin-plugins-docs",
        "readme:check": "pumpkin-plugins-docs --check",
        "test": "vitest run --project unit --passWithNoTests",
        "test:coverage": "vitest run --project unit --coverage --passWithNoTests",
        "test:integration": "vitest run --project integration",
        "typecheck": "pnpm types && tsc --noEmit",
        "types": "pumpkin-plugins-build --types-only"
    },
    "dependencies": {
        "@pumpkin-plugins/plugin-kit": "workspace:*",
        "@pumpkin-plugins/pumpkin-api": "catalog:"
    },
    "devDependencies": {
        "@pumpkin-plugins/build": "workspace:*",
        "@pumpkin-plugins/docs": "workspace:*",
        "@pumpkin-plugins/test-harness": "workspace:*",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "pumpkinPlugin": {
        "entry": "src/plugin.ts",
        "output": "build/{{ name }}.wasm",
        "wasi": [
            "http"
        ]
    }
}
