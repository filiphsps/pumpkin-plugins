{
    "name": "{{name}}",
    "displayName": {{{ json displayName }}},
    "version": "0.0.0",
    "private": true,
    "description": {{{ json description }}},
    "categories": ["Other"],
    "funding": {{{ json rootPackage.funding }}},
    "author": {{{ json rootPackage.author }}},
    "contributors": {{{ json rootPackage.contributors }}},
    "publisher": "filiph",
    "main": "./dist/extension.js",
    "scripts": {
        "build": "tsc -p .",
        "typecheck": "tsc -p . --noEmit",
        "test": "vitest run",
        "package": "node ../../scripts/package-extension.mjs"
    },
    "contributes": {
        "commands": [
            {
                "command": "{{name}}.helloWorld",
                "title": {{{ helloWorld displayName }}}
            }
        ]
    },
    "devDependencies": {
        "@types/vscode": "catalog:",
        "@vscode/vsce": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "vscode": "^{{ vscodeVersion }}"
    }
}
