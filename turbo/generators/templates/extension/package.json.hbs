{
    "name": "{{name}}",
    "displayName": {{{ json displayName }}},
    "version": "0.0.0",
    "private": true,
    "description": {{{ json description }}},
    "categories": ["Other"],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins/tree/master/extensions/{{name}}#readme",
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git",
        "directory": "extensions/{{name}}"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "license": "MIT",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "publisher": "filiph",
    "main": "./dist/extension.js",
    "scripts": {
        "build": "tsc -p .",
        "typecheck": "tsc -p . --noEmit",
        "test": "vitest run",
        "package": "node ../../scripts/package-extension.mjs"
    },
    "contributes": {
        "commands": [
            {
                "command": "{{name}}.helloWorld",
                "title": {{{ helloWorld displayName }}}
            }
        ]
    },
    "devDependencies": {
        "@types/vscode": "catalog:",
        "@vscode/vsce": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "vscode": "^1.140.0"
    }
}
