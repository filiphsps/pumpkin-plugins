{
    "name": "@pumpkin-plugins/minecraft-colors",
    "version": "0.1.0",
    "description": "Chalk-like Minecraft text formatting for plugins",
    "keywords": [
        "minecraft",
        "pumpkin",
        "colors",
        "formatting",
        "chat",
        "text-formatting"
    ],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins/tree/master/tools/minecraft-colors#readme",
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git",
        "directory": "tools/minecraft-colors"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "license": "MIT",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "prepack": "pnpm build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
