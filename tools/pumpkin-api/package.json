{
    "name": "@pumpkin-plugins/pumpkin-api",
    "version": "0.1.0",
    "description": "TypeScript API for PumpkinMC plugins",
    "keywords": [
        "minecraft",
        "pumpkin",
        "plugin",
        "api",
        "typescript",
        "webassembly",
        "wasi"
    ],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins/tree/master/tools/pumpkin-api#readme",
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git",
        "directory": "tools/pumpkin-api"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "license": "MIT",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./package.json": "./package.json",
        "./wit": {
            "types": "./src/wit.d.mts",
            "import": "./src/wit.mjs"
        }
    },
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "files": [
        "dist",
        "src/wit.mjs",
        "src/wit.d.mts",
        "schemas",
        "wit.lock.json",
        "compatibility",
        "docs",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "pnpm gen:types && tsc -p tsconfig.build.json",
        "gen:types": "node scripts/gen-types.mjs",
        "prepack": "pnpm build",
        "readme": "pumpkin-plugins-docs generate docs.ts",
        "readme:check": "pumpkin-plugins-docs generate docs.ts --check",
        "test": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "test:upstream": "vitest run --project upstream",
        "typecheck": "pnpm gen:types && tsc --noEmit"
    },
    "devDependencies": {
        "@bytecodealliance/jco": "catalog:",
        "@pumpkin-plugins/docs": "workspace:*",
        "@pumpkin-plugins/test-harness": "workspace:*",
        "@types/node": "catalog:",
        "ajv": "8.20.0",
        "commander": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24.21.0"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "./package.json": "./package.json",
            "./wit": {
                "types": "./src/wit.d.mts",
                "import": "./src/wit.mjs"
            }
        },
        "main": "./dist/index.js",
        "module": "./dist/index.js",
        "types": "./dist/index.d.ts"
    }
}
