{
    "name": "@pumpkin-plugins/pumpkin-api",
    "version": "0.1.0",
    "description": "TypeScript API for PumpkinMC plugins",
    "license": "MIT",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins/tree/master/tools/pumpkin-api#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git",
        "directory": "tools/pumpkin-api"
    },
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./package.json": "./package.json",
        "./wit": {
            "types": "./src/wit.d.mts",
            "import": "./src/wit.mjs"
        }
    },
    "files": [
        "src/**/*.ts",
        "src/**/*.mts",
        "src/**/*.mjs",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts",
        "schemas",
        "wit.lock.json",
        "compatibility",
        "docs",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "gen:types": "node scripts/gen-types.mjs",
        "typecheck": "pnpm gen:types && tsc --noEmit",
        "test": "vitest run --project unit",
        "test:upstream": "vitest run --project upstream",
        "test:integration": "vitest run --project integration",
        "readme": "pumpkin-plugins-docs generate docs.ts",
        "readme:check": "pumpkin-plugins-docs generate docs.ts --check"
    },
    "devDependencies": {
        "@bytecodealliance/jco": "catalog:",
        "@pumpkin-plugins/docs": "workspace:*",
        "@pumpkin-plugins/test-harness": "workspace:*",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24.21.0"
    },
    "main": "./src/index.ts"
}
