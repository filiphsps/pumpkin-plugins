{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/filiphsps/pumpkin-plugins/tools/pumpkin-api/schemas/upstream-git-pin.schema.json",
    "title": "Upstream Git pin",
    "description": "The Pumpkin API's upstream WIT repository branch pinned to an immutable Git object ID and package directory.",
    "type": "object",
    "additionalProperties": false,
    "required": ["$schema", "repository", "branch", "commit", "subdirectory"],
    "properties": {
        "$schema": {
            "type": "string",
            "format": "uri-reference",
            "const": "schemas/upstream-git-pin.schema.json"
        },
        "repository": {
            "type": "string",
            "format": "uri",
            "minLength": 1
        },
        "branch": {
            "type": "string",
            "minLength": 1
        },
        "commit": {
            "type": "string",
            "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$",
            "description": "A SHA-1 or SHA-256 Git object ID."
        },
        "subdirectory": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.{1,2})(?:/|$))[^/]+(?:/[^/]+)*$",
            "description": "Repository-relative directory containing the pinned WIT package."
        }
    }
}
