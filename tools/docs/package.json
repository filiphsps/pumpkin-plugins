{
    "name": "@pumpkin-plugins/docs",
    "version": "0.1.2",
    "description": "Generates component READMEs, doc links, and repository catalogs",
    "keywords": [
        "minecraft",
        "pumpkin",
        "plugin",
        "documentation",
        "readme",
        "generator"
    ],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins/tree/master/tools/docs#readme",
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git",
        "directory": "tools/docs"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "license": "MIT",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": "./src/info.ts",
        "./markdown": "./src/markdown.ts",
        "./node": "./src/node.ts"
    },
    "module": "./src/info.ts",
    "types": "./src/info.ts",
    "bin": {
        "pumpkin-plugins-docs": "bin/pumpkin-plugins-docs.mjs"
    },
    "files": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts",
        "bin/**/*.mjs",
        "README.md"
    ],
    "scripts": {
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "commander": "catalog:",
        "smol-toml": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24.21.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
