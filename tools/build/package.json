{
    "name": "@pumpkin-plugins/build",
    "version": "0.1.5",
    "description": "Shared build tool for the plugins",
    "keywords": [
        "minecraft",
        "pumpkin",
        "plugin",
        "build-tool",
        "webassembly",
        "wasm",
        "wasi"
    ],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins/tree/master/tools/build#readme",
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git",
        "directory": "tools/build"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "license": "MIT",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "type": "module",
    "bin": {
        "pumpkin-plugins-build": "dist/cli.js"
    },
    "files": [
        "dist",
        "globals.d.ts",
        "runtime",
        "wasi-wit.lock.json"
    ],
    "scripts": {
        "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --splitting --target=node24 --packages=external --alias:@pumpkin-plugins/minecraft-colors=../minecraft-colors/src/index.ts --outdir=dist",
        "prepack": "pnpm build",
        "readme": "pumpkin-plugins-docs generate docs.ts",
        "readme:check": "pumpkin-plugins-docs generate docs.ts --check",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@badisi/latest-version": "catalog:",
        "@bytecodealliance/jco": "catalog:",
        "@commander-js/extra-typings": "catalog:",
        "@di-framework/componentize-qjs": "0.4.4-di.3",
        "@pumpkin-plugins/pumpkin-api": "catalog:",
        "@pumpkin-plugins/static-hermes-runtime": "workspace:*",
        "@pumpkin-plugins/wasi-capabilities": "catalog:",
        "commander": "catalog:",
        "esbuild": "catalog:",
        "typescript": "catalog:"
    },
    "devDependencies": {
        "@pumpkin-plugins/docs": "workspace:*",
        "@pumpkin-plugins/minecraft-colors": "workspace:*",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24.21.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
