{
    "name": "@pumpkin-plugins/plugin-kit",
    "version": "0.1.1",
    "description": "Shared lifecycle, command, task, logging, and file helpers for plugins",
    "keywords": [
        "minecraft",
        "pumpkin",
        "plugin",
        "typescript",
        "wasi",
        "runtime"
    ],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins/tree/master/tools/plugin-kit#readme",
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git",
        "directory": "tools/plugin-kit"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "license": "MIT",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "sideEffects": false,
    "type": "module",
    "exports": {
        "./commands": "./src/commands.ts",
        "./data-dir": "./src/data-dir.ts",
        "./files": "./src/files.ts",
        "./handlers": "./src/handlers.ts",
        "./host": "./src/host.ts",
        "./ipc": "./src/ipc.ts",
        "./logger": "./src/logger.ts",
        "./plugin": "./src/plugin.ts",
        "./payload": "./src/payload.ts",
        "./registry-id": "./src/registry-id.ts",
        "./register-commands": "./src/register-commands.ts",
        "./testing": "./src/testing/index.ts",
        "./wasi-resource": "./src/wasi-resource.ts",
        "./wasi-error": "./src/wasi-error.ts",
        "./wasi-clock": "./src/wasi-clock.ts",
        "./wasi-number": "./src/wasi-number.ts",
        "./wasi-socket": "./src/wasi-socket.ts"
    },
    "files": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts"
    ],
    "scripts": {
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "pumpkin-plugins-build --types-only && tsc --noEmit"
    },
    "dependencies": {
        "@pumpkin-plugins/docs": "workspace:*",
        "@pumpkin-plugins/pumpkin-api": "catalog:",
        "@pumpkin-plugins/update-check": "workspace:*"
    },
    "devDependencies": {
        "@pumpkin-plugins/build": "workspace:*",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24.21.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "pumpkinPlugin": {
        "wasi": [
            "filesystem",
            "sockets",
            "http"
        ]
    }
}
