{
    "extends": ["//"],
    "tasks": {
        "build": {
            "dependsOn": [
                "transit",
                "@pumpkin-plugins/static-analysis#build",
                "@pumpkin-plugins/wasi-capabilities#build"
            ]
        },
        "test": {
            "dependsOn": [
                "transit",
                "@pumpkin-plugins/static-analysis#build",
                "@pumpkin-plugins/wasi-capabilities#build"
            ]
        },
