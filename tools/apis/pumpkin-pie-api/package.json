{
    "name": "@pumpkin-plugins/pumpkin-pie-api",
    "version": "0.1.1",
    "description": "PumpkinPIE client for protocol checks and placeholder expansion",
    "keywords": [
        "minecraft",
        "pumpkin",
        "pumpkin-pie",
        "api",
        "client",
        "expansions",
        "typescript"
    ],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins/tree/master/tools/apis/pumpkin-pie-api#readme",
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git",
        "directory": "tools/apis/pumpkin-pie-api"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "license": "MIT",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./testing": "./src/testing/index.ts",
        "./testing/provider": "./test/provider.ts"
    },
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "files": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts"
    ],
    "scripts": {
        "readme": "pumpkin-plugins-docs generate docs.ts",
        "readme:check": "pumpkin-plugins-docs generate docs.ts --check",
        "test": "vitest run --project unit",
        "test:coverage": "vitest run --project unit --coverage",
        "test:integration": "vitest run --project integration",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "fflate": "catalog:"
    },
    "devDependencies": {
        "@pumpkin-plugins/build": "workspace:*",
        "@pumpkin-plugins/docs": "workspace:*",
        "@pumpkin-plugins/plugin-kit": "workspace:*",
        "@pumpkin-plugins/pumpkin-api": "catalog:",
        "@pumpkin-plugins/test-harness": "workspace:*",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24.21.0"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": "./src/index.ts",
            "./testing": "./src/testing/index.ts"
        }
    }
}
