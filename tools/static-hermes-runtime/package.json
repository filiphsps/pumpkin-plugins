{
    "name": "@pumpkin-plugins/static-hermes-runtime",
    "version": "0.1.1",
    "description": "Static Hermes Runtime shim for Pumpkin plugin components",
    "keywords": [
        "minecraft",
        "pumpkin",
        "hermes",
        "javascript",
        "webassembly",
        "wasm",
        "wasi"
    ],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins/tree/master/tools/static-hermes-runtime#readme",
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git",
        "directory": "tools/static-hermes-runtime"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "license": "MIT",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "static-hermes-runtime": "dist/cli.js"
    },
    "files": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts",
        "src/**/*.template",
        "dist",
        "cmake",
        "hermes-patches",
        "hermes-source.lock.json",
        "toolchain-versions.json",
        "wasi-sdk.lock.json",
        "wasm-tools.lock.json",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "compatibility:refresh": "node test/fixtures/generate-pumpkin-api-fixtures.mjs",
        "prepack": "pnpm build",
        "prepare-hermes": "pnpm build && node dist/cli.js hermes prepare",
        "readme": "pumpkin-plugins-docs generate docs.ts",
        "readme:check": "pumpkin-plugins-docs generate docs.ts --check",
        "test": "pnpm build && vitest run",
        "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@commander-js/extra-typings": "catalog:",
        "@types/node": "catalog:",
        "commander": "catalog:",
        "esbuild": "catalog:"
    },
    "devDependencies": {
        "@pumpkin-plugins/docs": "workspace:*",
        "@pumpkin-plugins/pumpkin-api": "catalog:",
        "@pumpkin-plugins/test-harness": "workspace:*",
        "@pumpkin-plugins/wasi-capabilities": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24.21.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
