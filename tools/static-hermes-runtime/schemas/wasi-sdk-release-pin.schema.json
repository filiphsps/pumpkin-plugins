{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/filiphsps/pumpkin-plugins/master/schemas/wasi-sdk-release-pin.schema.json",
    "title": "WASI SDK release pin",
    "description": "A WASI SDK release pinned to its upstream repository and per-platform archive digests.",
    "type": "object",
    "additionalProperties": false,
    "required": ["repository", "version", "checksums"],
    "properties": {
        "$schema": {
            "type": "string",
            "format": "uri-reference",
            "const": "https://raw.githubusercontent.com/filiphsps/pumpkin-plugins/master/schemas/wasi-sdk-release-pin.schema.json",
            "minLength": 1
        },
        "repository": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\.com/WebAssembly/wasi-sdk/?$"
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?$"
        },
        "checksums": {
            "type": "object",
            "description": "Trusted lowercase SHA-256 digests keyed by Node platform and architecture.",
            "additionalProperties": false,
            "required": [
                "darwin/arm64",
                "darwin/x64",
                "linux/arm64",
                "linux/riscv64",
                "linux/x64",
                "win32/arm64",
                "win32/x64"
            ],
            "properties": {
                "darwin/arm64": { "$ref": "#/$defs/sha256" },
                "darwin/x64": { "$ref": "#/$defs/sha256" },
                "linux/arm64": { "$ref": "#/$defs/sha256" },
                "linux/riscv64": { "$ref": "#/$defs/sha256" },
                "linux/x64": { "$ref": "#/$defs/sha256" },
                "win32/arm64": { "$ref": "#/$defs/sha256" },
                "win32/x64": { "$ref": "#/$defs/sha256" }
            }
        }
    },
    "$defs": {
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        }
    }
}
