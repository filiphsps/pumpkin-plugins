+CallResult<HermesValue> JSStringIterator::nextElementFast(
+    Handle<JSStringIterator> self,
+    Runtime &runtime) {
+  if (!self->iteratedString_)
+    return HermesValue::encodeUndefinedValue();
+
+  struct : public Locals {
+    PinnedValue<StringPrimitive> string;
+    PinnedValue<StringPrimitive> result;
+  } lv;
+  LocalsRAII lraii(runtime, &lv);
+  lv.string = self->iteratedString_.get(runtime);
+
+  uint32_t position = self->nextIndex_;
+  uint32_t length = lv.string->getStringLength();
+  if (position >= length) {
+    self->iteratedString_.setNull(runtime.getHeap());
+    return HermesValue::encodeUndefinedValue();
+  }
+
+  char16_t first = lv.string->at(position);
+  uint32_t resultSize = 1;
+  if (first >= 0xd800 && first <= 0xdbff && position + 1 < length) {
+    char16_t second = lv.string->at(position + 1);
+    if (second >= 0xdc00 && second <= 0xdfff) {
+      char16_t charArr[2]{first, second};
+      auto strRes = StringPrimitive::create(runtime, UTF16Ref{charArr, 2});
+      if (LLVM_UNLIKELY(strRes == ExecutionStatus::EXCEPTION))
+        return ExecutionStatus::EXCEPTION;
+      lv.result = vmcast<StringPrimitive>(*strRes);
+      resultSize = 2;
+    }
+  }
+
+  if (resultSize == 1)
+    lv.result = runtime.getCharacterString(first);
+  self->nextIndex_ = position + resultSize;
+  return lv.result.getHermesValue();
+}
