+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+// RUN: %shermes -exec %s | %FileCheck --match-full-lines %s
+
+function describeCharacters(value) {
+    var characters = [];
+    for (var character of value) {
+        var codeUnits = [];
+        for (var i = 0; i < character.length; ++i)
+            codeUnits.push(character.charCodeAt(i));
+        characters.push(codeUnits.join("+"));
+    }
+    return characters.join("|");
+}
+
+print("empty:" + describeCharacters(""));
+// CHECK: empty:
+print("ascii:" + describeCharacters("aZ0"));
+// CHECK-NEXT: ascii:97|90|48
+print("bmp:" + describeCharacters("A\u00e9\u4e2d"));
+// CHECK-NEXT: bmp:65|233|20013
+print("pair:" + describeCharacters("\ud83d\ude00"));
+// CHECK-NEXT: pair:55357+56832
+print("lone:" + describeCharacters("\ud83dA\ude00"));
+// CHECK-NEXT: lone:55357|65|56832
+
+var firstCharacter = "";
+for (var character of "abc") {
+    firstCharacter = character;
+    break;
+}
+print("break:" + firstCharacter);
+// CHECK-NEXT: break:a
+
+var originalStringIterator = String.prototype[Symbol.iterator];
+var originalStringIteratorDescriptor = Object.getOwnPropertyDescriptor(
+    String.prototype,
+    Symbol.iterator
+);
+Object.defineProperty(String.prototype, Symbol.iterator, {
+    configurable: true,
+    writable: true,
+    value: function() {
+        var index = 0;
+        return {
+            next: function() {
+                ++index;
+                return {value: "custom" + index, done: index > 1};
+            },
+        };
+    },
+});
+var customIteratorOutput = "";
+for (var character of "abc")
+    customIteratorOutput += character;
+print("custom-iterator:" + customIteratorOutput);
+// CHECK-NEXT: custom-iterator:custom1
+Object.defineProperty(
+    String.prototype,
+    Symbol.iterator,
+    originalStringIteratorDescriptor
+);
+
+var stringIteratorPrototype = Object.getPrototypeOf(
+    originalStringIterator.call("")
+);
+var originalNextDescriptor = Object.getOwnPropertyDescriptor(
+    stringIteratorPrototype,
+    "next"
+);
+Object.defineProperty(stringIteratorPrototype, "next", {
+    configurable: true,
+    writable: true,
+    value: function() {
+        return {value: "custom-next", done: false};
+    },
+});
+var customNextCharacter = "";
+for (var character of "abc") {
+    customNextCharacter = character;
+    break;
+}
+print("custom-next:" + customNextCharacter);
+// CHECK-NEXT: custom-next:custom-next
+Object.defineProperty(stringIteratorPrototype, "next", originalNextDescriptor);
+
+var originalReturnDescriptor = Object.getOwnPropertyDescriptor(
+    stringIteratorPrototype,
+    "return"
+);
+var returnGetterCalls = 0;
+var returnCalls = 0;
+Object.defineProperty(stringIteratorPrototype, "return", {
+    configurable: true,
+    get: function() {
+        ++returnGetterCalls;
+        return function() {
+            ++returnCalls;
+            return {};
+        };
+    },
+});
+firstCharacter = "";
+for (var character of "abc") {
+    firstCharacter = character;
+    break;
+}
+print("custom-return:" + firstCharacter + ":" + returnGetterCalls + ":" + returnCalls);
+// CHECK-NEXT: custom-return:a:1:1
+if (originalReturnDescriptor === undefined)
+    delete stringIteratorPrototype.return;
+else
+    Object.defineProperty(
+        stringIteratorPrototype,
+        "return",
+        originalReturnDescriptor
+    );
+
+var dynamicReturnCalls = 0;
+for (var character of "abc") {
+    Object.defineProperty(stringIteratorPrototype, "return", {
+        configurable: true,
+        value: function() {
+            ++dynamicReturnCalls;
+            return {};
+        },
+    });
+    break;
+}
+print("dynamic-return:" + dynamicReturnCalls);
+// CHECK-NEXT: dynamic-return:1
+if (originalReturnDescriptor === undefined)
+    delete stringIteratorPrototype.return;
+else
+    Object.defineProperty(
+        stringIteratorPrototype,
+        "return",
+        originalReturnDescriptor
+    );
+
+print("restored:" + describeCharacters("xy"));
+// CHECK-NEXT: restored:120|121
