+namespace {
+
+template <typename Name>
+bool hasOwnDataPropertyValue(
+    Handle<JSObject> object,
+    Runtime &runtime,
+    Name name,
+    HermesValue expectedValue) {
+  NamedPropertyDescriptor desc;
+  JSObject *propObj =
+      JSObject::getNamedDescriptorPredefined(object, runtime, name, desc);
+  if (propObj != object.get() || desc.flags.accessor || desc.flags.proxyObject ||
+      desc.flags.hostObject)
+    return false;
+
+  return JSObject::getNamedSlotValueUnsafe(propObj, runtime, desc).getRaw() ==
+      expectedValue.getRaw();
+}
+
+bool isStringIteratorFastPathSafe(Runtime &runtime) {
+  // Verify captured hooks; the real iterator keeps dynamic close semantics.
+  if (runtime.stringPrototype->getParent(runtime) != *runtime.objectPrototype ||
+      runtime.stringIteratorPrototype->getParent(runtime) !=
+          *runtime.iteratorPrototype ||
+      runtime.iteratorPrototype->getParent(runtime) !=
+          *runtime.objectPrototype ||
+      runtime.objectPrototype->getParent(runtime) != nullptr)
+    return false;
+
+  auto stringPrototype = Handle<JSObject>::vmcast(&runtime.stringPrototype);
+  if (!hasOwnDataPropertyValue(
+          stringPrototype,
+          runtime,
+          Predefined::SymbolIterator,
+          runtime.stringPrototypeIterator.getHermesValue()))
+    return false;
+
+  auto stringIteratorPrototype =
+      Handle<JSObject>::vmcast(&runtime.stringIteratorPrototype);
+  if (!hasOwnDataPropertyValue(
+          stringIteratorPrototype,
+          runtime,
+          Predefined::next,
+          runtime.stringIteratorPrototypeNext.getHermesValue()))
+    return false;
+
+  return true;
+}
+
