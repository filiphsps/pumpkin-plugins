+TEST_F(JSLibTest, StringFastPathResultsUseCompactASCIIStorage) {
+  auto runRes = runtime.run(
+      R"(
+        [
+          'MiXeD ASCII'.toLowerCase(),
+          'mixed ascii'.toUpperCase(),
+          new Uint8Array([65, 66]).join('-'),
+          new Uint8Array([1, 2]).toLocaleString(),
+          String.fromCharCode(65, 66, 67),
+          'alpha'.replace('ph', 'PH'),
+          'aba'.replaceAll('a', 'A'),
+          atob('YWJj'),
+          String.fromCharCode(65, 128),
+          new Uint8Array([65, 66]).join('\u03bb'),
+          (() => {
+            const original = Number.prototype.toLocaleString;
+            Number.prototype.toLocaleString = () => '\u03bb';
+            const result = new Uint8Array([1, 2]).toLocaleString();
+            Number.prototype.toLocaleString = original;
+            return result;
+          })(),
+          'A\u03bbB'.replace('A', 'X'),
+          atob('gA=='),
+        ];
+      )",
+      "string-fast-path-test.js",
+      CompileFlags{});
+  ASSERT_RETURNED(runRes.getStatus());
+
+  auto results = runtime.makeHandle<JSArray>(vmcast<JSArray>(*runRes));
+
+  auto expectString = [&](uint32_t index,
+                          UTF16Ref expected,
+                          bool expectedASCII) {
+    auto actual = runtime.makeHandle<StringPrimitive>(
+        results->at(runtime, index).getString(runtime));
+    EXPECT_EQ(expectedASCII, actual->isASCII());
+    EXPECT_TRUE(
+        StringPrimitive::createStringView(runtime, actual).equals(expected));
+  };
+
+  expectString(0, createUTF16Ref(u"mixed ascii"), true);
+  expectString(1, createUTF16Ref(u"MIXED ASCII"), true);
+  expectString(2, createUTF16Ref(u"A-B"), true);
+  expectString(3, createUTF16Ref(u"1,2"), true);
+  expectString(4, createUTF16Ref(u"ABC"), true);
+  expectString(5, createUTF16Ref(u"alPha"), true);
+  expectString(6, createUTF16Ref(u"AbA"), true);
+  expectString(7, createUTF16Ref(u"abc"), true);
+  expectString(8, createUTF16Ref(u"A\u0080"), false);
+  expectString(9, createUTF16Ref(u"A\u03bbB"), false);
+  expectString(10, createUTF16Ref(u"\u03bb,\u03bb"), false);
+  expectString(11, createUTF16Ref(u"X\u03bbB"), false);
+  expectString(12, createUTF16Ref(u"\u0080"), false);
+}
