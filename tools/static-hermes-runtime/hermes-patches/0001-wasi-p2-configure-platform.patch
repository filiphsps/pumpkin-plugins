Subject: [PATCH] Configure CMake for a WASI preview 2 target

Hermes picks its platform from WIN32, UNIX and FUCHSIA, none of which
describe WASI. Treat WASI as a Unix-like LLVH target without threads or
link version scripts, add OSCompatWASI.cpp to the support library, and
keep _WINDOWS out of WASI builds on Windows hosts. That last check runs
before project(), so it reads HERMES_WASI_TARGET, which the runtime's
build passes, instead of CMAKE_SYSTEM_NAME.

Upstream: not submitted. Hermes has no WASI target.
---
 CMakeLists.txt               |  3 ++-
 cmake/modules/Hermes.cmake   | 18 ++++++++++++------
 external/llvh/CMakeLists.txt |  6 +++++-
 lib/Support/CMakeLists.txt   |  1 +
 4 files changed, 20 insertions(+), 8 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 66cb429..87235fd 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -59,7 +59,8 @@ if(HERMES_APPLE_TARGET_PLATFORM MATCHES "catalyst")
   set(THREADS_PREFER_PTHREAD_FLAG ON)
 endif()
 
-if (WIN32)
+# This runs before project(), so CMAKE_SYSTEM_NAME is not set yet; the WASI build passes HERMES_WASI_TARGET=ON.
+if (WIN32 AND NOT HERMES_WASI_TARGET)
 add_definitions(-D_WINDOWS)
 endif()
 
diff --git a/cmake/modules/Hermes.cmake b/cmake/modules/Hermes.cmake
index 466b01d..0820cdc 100644
--- a/cmake/modules/Hermes.cmake
+++ b/cmake/modules/Hermes.cmake
@@ -39,7 +39,7 @@ elseif (MINGW) # FIXME: Also cygwin?
   set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -Wl,--stack,16777216")
 endif ()
 
-if (WIN32)
+if (WIN32 AND NOT CMAKE_SYSTEM_NAME STREQUAL "WASI")
   set(LLVM_HAVE_LINK_VERSION_SCRIPT 0)
   if (CYGWIN)
     set(LLVM_ON_WIN32 0)
@@ -48,8 +48,14 @@ if (WIN32)
     set(LLVM_ON_WIN32 1)
     set(LLVM_ON_UNIX 0)
   endif (CYGWIN)
-else (WIN32)
-  if (FUCHSIA OR UNIX)
+else ()
+  if (CMAKE_SYSTEM_NAME STREQUAL "WASI")
+    set(LLVM_ON_WIN32 0)
+    # WASI exposes Unix file-status structures but lacks some APIs used by
+    # process, signal, and path helpers.
+    set(LLVM_ON_UNIX 1)
+    set(LLVM_HAVE_LINK_VERSION_SCRIPT 0)
+  elseif (FUCHSIA OR UNIX)
     set(LLVM_ON_WIN32 0)
     set(LLVM_ON_UNIX 1)
     if (APPLE OR ${CMAKE_SYSTEM_NAME} MATCHES "AIX")
@@ -57,10 +63,10 @@ else (WIN32)
     else ()
       set(LLVM_HAVE_LINK_VERSION_SCRIPT 1)
     endif ()
-  else (FUCHSIA OR UNIX)
+  else ()
     MESSAGE(SEND_ERROR "Unable to determine platform")
-  endif (FUCHSIA OR UNIX)
-endif (WIN32)
+  endif ()
+endif ()
 
 # Set C++ exception handling and RTTI flags for a target.
 # Uses generator expressions to apply flags only to C++ source files,
diff --git a/external/llvh/CMakeLists.txt b/external/llvh/CMakeLists.txt
index 5944b9c..6e4fc05 100644
--- a/external/llvh/CMakeLists.txt
+++ b/external/llvh/CMakeLists.txt
@@ -11,7 +11,11 @@ set(PACKAGE_NAME "LLVH")
 set(PACKAGE_STRING "LLVH 8.0.0svn")
 set(PACKAGE_VERSION "8.0.0svn")
 
-set(LLVM_ENABLE_THREADS 1)
+if (CMAKE_SYSTEM_NAME STREQUAL "WASI")
+  set(LLVM_ENABLE_THREADS 0)
+else()
+  set(LLVM_ENABLE_THREADS 1)
+endif()
 if (LLVH_REVERSE_ITERATION)
   set(LLVM_ENABLE_REVERSE_ITERATION 1)
 endif ()
diff --git a/lib/Support/CMakeLists.txt b/lib/Support/CMakeLists.txt
index ea2f227..a6421d6 100644
--- a/lib/Support/CMakeLists.txt
+++ b/lib/Support/CMakeLists.txt
@@ -35,6 +35,7 @@ add_hermes_library(hermesSupport
         OSCompatEmscripten.cpp
         OSCompatPosix.cpp
         OSCompatWindows.cpp
+        OSCompatWASI.cpp
         PageAccessTrackerPosix.cpp
         PerfSection.cpp
         SemaphorePosix.cpp
