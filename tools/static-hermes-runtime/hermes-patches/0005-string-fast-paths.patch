Subject: [PATCH] Keep ASCII results compact in join and integer toString

Array.prototype.join tracks whether every part is ASCII so the result can
use compact one-byte storage. Number.prototype.toString with a radix
converts safe integers with integer division instead of the general
floating-point path.

Plugins build many strings this way. These are performance changes with
no change to results; drop them if upstream Hermes adds the same paths.

Upstream: not submitted.
---
 lib/VM/JSLib/Array.cpp | 13 +++++++++----
 lib/VM/Operations.cpp  | 22 ++++++++++++++++++++++
 2 files changed, 31 insertions(+), 4 deletions(-)

diff --git a/lib/VM/JSLib/Array.cpp b/lib/VM/JSLib/Array.cpp
index 9bde390..8947108 100644
--- a/lib/VM/JSLib/Array.cpp
+++ b/lib/VM/JSLib/Array.cpp
@@ -1115,6 +1115,8 @@ CallResult<HermesValue> arrayPrototypeJoin(void *, Runtime &runtime) {
 
   // The first element not processed by the fast path.
   uint32_t fastPathEnd = 0;
+  // Preserve ASCII knowledge so the result can use compact string storage.
+  bool isASCII = lv.sep->isASCII();
 
   // 1. Fast Path: Process as many elements as possible quickly.
   if (JSArray *arr = dyn_vmcast<JSArray>(lv.O.get());
@@ -1133,9 +1135,11 @@ CallResult<HermesValue> arrayPrototypeJoin(void *, Runtime &runtime) {
     for (i = 0; i < len; ++i) {
       SmallHermesValue elem = storage->at(i); // Direct access
       uint32_t elemLen;
-      if (elem.isString())
-        elemLen = elem.getString(runtime)->getStringLength();
-      else if (elem.isNull() || elem.isUndefined() || elem.isEmpty())
+      if (elem.isString()) {
+        StringPrimitive *str = elem.getString(runtime);
+        elemLen = str->getStringLength();
+        isASCII = isASCII && str->isASCII();
+      } else if (elem.isNull() || elem.isUndefined() || elem.isEmpty())
         elemLen = 0;
       else
         break;
@@ -1221,6 +1225,7 @@ CallResult<HermesValue> arrayPrototypeJoin(void *, Runtime &runtime) {
           return ExecutionStatus::EXCEPTION;
 
         StringPrimitive *s = strRes.getValue().get();
+        isASCII = isASCII && s->isASCII();
         size.add(s->getStringLength());
 
         lv.strings->set(
@@ -1239,7 +1244,7 @@ CallResult<HermesValue> arrayPrototypeJoin(void *, Runtime &runtime) {
   }
 
   // Allocate the complete result.
-  auto builder = StringBuilder::createStringBuilder(runtime, size);
+  auto builder = StringBuilder::createStringBuilder(runtime, size, isASCII);
   if (builder == ExecutionStatus::EXCEPTION) {
     return ExecutionStatus::EXCEPTION;
   }
diff --git a/lib/VM/Operations.cpp b/lib/VM/Operations.cpp
index ea2484f..d3fe153 100644
--- a/lib/VM/Operations.cpp
+++ b/lib/VM/Operations.cpp
@@ -1384,6 +1384,28 @@ numberToStringWithRadix(Runtime &runtime, double number, unsigned radix) {
     number = -number;
   }
 
+  // Safe integers can use exact integer division, avoiding floating-point
+  // decomposition in the general radix conversion below.
+  constexpr double MAX_SAFE_INTEGER = 9007199254740991.0;
+  if (std::isfinite(number) && number <= MAX_SAFE_INTEGER &&
+      std::floor(number) == number) {
+    uint64_t integerPart = static_cast<uint64_t>(number);
+    if (integerPart == 0) {
+      result.push_back('0');
+    }
+    while (integerPart > 0) {
+      unsigned digit = static_cast<unsigned>(integerPart % radix);
+      result.push_back(toRadixChar(digit, radix));
+      integerPart /= radix;
+    }
+    std::reverse(result.begin(), result.end());
+    if (negative) {
+      result.insert(result.begin(), '-');
+    }
+    return runtime.makeHandle<StringPrimitive>(runtime.ignoreAllocationFailure(
+        StringPrimitive::create(runtime, result)));
+  }
+
   // Split number into integer and fractional parts.
   double iPart;
   double fPart = std::modf(number, &iPart);
