Subject: [PATCH] Add WASI signal and watchdog stubs to LLVH

WASI has no signals or alarm timer. Provide empty Signals.inc and
Watchdog.inc implementations so crash handlers and the PrettyStackTrace
timeout compile and do nothing, as on Windows.

Upstream: not submitted. Needed only for a WASI target.
---
 external/llvh/lib/Support/Wasi/Signals.inc  | 34 +++++++++++++++++++++
 external/llvh/lib/Support/Wasi/Watchdog.inc |  8 +++++
 2 files changed, 42 insertions(+)
 create mode 100644 external/llvh/lib/Support/Wasi/Signals.inc
 create mode 100644 external/llvh/lib/Support/Wasi/Watchdog.inc

diff --git a/external/llvh/lib/Support/Wasi/Signals.inc b/external/llvh/lib/Support/Wasi/Signals.inc
new file mode 100644
index 0000000..15d8419
--- /dev/null
+++ b/external/llvh/lib/Support/Wasi/Signals.inc
@@ -0,0 +1,34 @@
+//===- Wasi/Signals.inc - WASI Signals Implementation --------*- C++ -*-===//
+//
+//                     The LLVM Compiler Infrastructure
+//
+// This file is distributed under the University of Illinois Open Source
+// License. See LICENSE.TXT for details.
+//
+//===----------------------------------------------------------------------===//
+//
+// WASI has no signals. These hooks keep the LLVH signal API linkable and do
+// nothing.
+//
+//===----------------------------------------------------------------------===//
+
+void llvh::sys::AddSignalHandler(sys::SignalHandlerCallback FnPtr,
+                                 void *Cookie) { // Signal-safe.
+  (void)insertSignalHandler;
+}
+
+void llvh::sys::RunInterruptHandlers() {
+}
+
+void llvh::sys::PrintStackTraceOnErrorSignal(StringRef Argv0,
+                                             bool DisableCrashReporting) {
+}
+
+/// This platform does not have dl_iterate_phdr, so we do not yet know how to
+/// find all loaded DSOs.
+static bool findModulesAndOffsets(void **StackTrace, int Depth,
+                                  const char **Modules, intptr_t *Offsets,
+                                  const char *MainExecutableName,
+                                  StringSaver &StrPool) {
+  return false;
+}
diff --git a/external/llvh/lib/Support/Wasi/Watchdog.inc b/external/llvh/lib/Support/Wasi/Watchdog.inc
new file mode 100644
index 0000000..0e69f53
--- /dev/null
+++ b/external/llvh/lib/Support/Wasi/Watchdog.inc
@@ -0,0 +1,8 @@
+// WASI has no process-wide alarm signal. Keep the optional PrettyStackTrace
+// timeout inert, matching the existing Windows implementation.
+namespace llvh {
+namespace sys {
+Watchdog::Watchdog(unsigned int seconds) { (void)seconds; }
+Watchdog::~Watchdog() {}
+} // namespace sys
+} // namespace llvh
