pumpkin_plugin_command_argument_type_t commandArgumentType(Runtime &runtime,
                                                           const Value &value) {
    if (!value.isObject())
        throw JSError(runtime, "CommandNode.argument expects an argument type");
    auto object = value.asObject(runtime);
    const auto tag = utf8(runtime, object.getProperty(runtime, "tag"));
    pumpkin_plugin_command_argument_type_t result{};
    if (tag == "integer" || tag == "double") {
        const auto tuple = object.getProperty(runtime, "val")
                               .asObject(runtime)
                               .asArray(runtime);
        const auto minimum = tuple.getValueAtIndex(runtime, 0);
        const auto maximum = tuple.getValueAtIndex(runtime, 1);
        if (tag == "integer") {
            result.tag = PUMPKIN_PLUGIN_COMMAND_ARGUMENT_TYPE_INTEGER;
            result.val.integer.f0.is_some =
                !minimum.isUndefined() && !minimum.isNull();
            result.val.integer.f1.is_some =
                !maximum.isUndefined() && !maximum.isNull();
            if (result.val.integer.f0.is_some)
                result.val.integer.f0.val =
                    static_cast<int32_t>(minimum.asNumber());
            if (result.val.integer.f1.is_some)
                result.val.integer.f1.val =
                    static_cast<int32_t>(maximum.asNumber());
        } else {
            result.tag = PUMPKIN_PLUGIN_COMMAND_ARGUMENT_TYPE_DOUBLE;
            result.val.double_.f0.is_some =
                !minimum.isUndefined() && !minimum.isNull();
            result.val.double_.f1.is_some =
                !maximum.isUndefined() && !maximum.isNull();
            if (result.val.double_.f0.is_some)
                result.val.double_.f0.val = minimum.asNumber();
            if (result.val.double_.f1.is_some)
                result.val.double_.f1.val = maximum.asNumber();
        }
    } else if (tag == "players") {
        result.tag = PUMPKIN_PLUGIN_COMMAND_ARGUMENT_TYPE_PLAYERS;
    } else if (tag == "item") {
        result.tag = PUMPKIN_PLUGIN_COMMAND_ARGUMENT_TYPE_ITEM;
    } else if (tag == "string") {
        result.tag = PUMPKIN_PLUGIN_COMMAND_ARGUMENT_TYPE_STRING;
        const auto mode = utf8(runtime, object.getProperty(runtime, "val"));
        if (mode == "single-word")
            result.val.string = PUMPKIN_PLUGIN_COMMAND_STRING_TYPE_SINGLE_WORD;
        else if (mode == "greedy")
            result.val.string = PUMPKIN_PLUGIN_COMMAND_STRING_TYPE_GREEDY;
        else if (mode == "quotable")
            result.val.string = PUMPKIN_PLUGIN_COMMAND_STRING_TYPE_QUOTABLE;
        else
            throw JSError(runtime,
                          "Unknown Pumpkin string argument mode: " + mode);
    } else {
        throw JSError(runtime,
                      "Unsupported Pumpkin command argument type: " + tag);
    }
    return result;
}

