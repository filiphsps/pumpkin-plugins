struct ResourceState {
    ResourceKind kind;
    int32_t handle;
    bool owned;
    std::string interfaceName{};
    std::string resourceName{};
    std::string packageName{};
    bool valid = true;

    void drop() {
        if (!owned)
            return;
        owned = false;
        valid = false;
        switch (kind) {
        case ResourceKind::Context:
            pumpkin_plugin_context_context_drop_own(
                pumpkin_plugin_context_own_context_t{handle});
            break;
        case ResourceKind::Server:
            pumpkin_plugin_server_server_drop_own(
                pumpkin_plugin_server_own_server_t{handle});
            break;
        case ResourceKind::Entity:
            pumpkin_plugin_world_entity_drop_own(
                pumpkin_plugin_world_own_entity_t{handle});
            break;
        case ResourceKind::ChunkBuffer:
            pumpkin_plugin_world_chunk_buffer_drop_own(
                pumpkin_plugin_world_own_chunk_buffer_t{handle});
            break;
        case ResourceKind::Player:
            pumpkin_plugin_player_player_drop_own(
                pumpkin_plugin_player_own_player_t{handle});
            break;
        case ResourceKind::World:
            pumpkin_plugin_world_world_drop_own(
                pumpkin_plugin_world_own_world_t{handle});
            break;
        case ResourceKind::JavaPlayer:
            pumpkin_plugin_player_java_player_drop_own(
                pumpkin_plugin_player_own_java_player_t{handle});
            break;
        case ResourceKind::Command:
            pumpkin_plugin_command_command_drop_own(
                pumpkin_plugin_command_own_command_t{handle});
            break;
        case ResourceKind::CommandNode:
            pumpkin_plugin_command_command_node_drop_own(
                pumpkin_plugin_command_own_command_node_t{handle});
            break;
        case ResourceKind::CommandSender:
            pumpkin_plugin_command_command_sender_drop_own(
                pumpkin_plugin_command_own_command_sender_t{handle});
            break;
        case ResourceKind::ConsumedArgs:
            pumpkin_plugin_command_consumed_args_drop_own(
                pumpkin_plugin_command_own_consumed_args_t{handle});
            break;
        case ResourceKind::Text:
            pumpkin_plugin_text_text_component_drop_own(
                pumpkin_plugin_text_own_text_component_t{handle});
            break;
        case ResourceKind::Wit:
            if (packageName.rfind("wasi:", 0) == 0)
                generatedWasiDropResource(packageName, interfaceName,
                                          resourceName, handle);
            else
                generatedWitDropResource(interfaceName, resourceName, handle);
            break;
        }
    }

    void transfer() {
        if (!owned)
            return;
        owned = false;
        valid = false;
    }
};

