bool exports_plugin_on_load(plugin_own_context_t context,
                            plugin_string_t *error) {
    if (error)
        std::memset(error, 0, sizeof(*error));
    std::shared_ptr<ResourceState> state;
    WitScopeGuard contextCleanup([&] {
        if (state)
            state->drop();
        else
            pumpkin_plugin_context_context_drop_own(
                pumpkin_plugin_context_own_context_t{context.__handle});
    });
    try {
        state = std::make_shared<ResourceState>(
            ResourceState{ResourceKind::Context, context.__handle, true});
        initializeRuntime();
        auto contextObject = wrapResourceObject(
            *jsRuntime, std::make_shared<ContextObject>(state));
        Value contextValue(std::move(contextObject));
        callExport("onLoad", &contextValue, 1);
        return true;
    } catch (const std::exception &exception) {
        setError(error, exception.what());
        return false;
    } catch (...) {
        setError(error, "Unknown Static Hermes plugin load failure");
        return false;
    }
}

bool exports_plugin_on_unload(plugin_own_context_t context,
                              plugin_string_t *error) {
    jsRuntime->global().setProperty(
        *jsRuntime, "__staticHermesPluginUnloading", Value(true));
    auto state = std::make_shared<ResourceState>(
        ResourceState{ResourceKind::Context, context.__handle, true});
    auto contextObject = wrapResourceObject(
        *jsRuntime, std::make_shared<ContextObject>(state));
    try {
        Value contextValue(std::move(contextObject));
        callExport("onUnload", &contextValue, 1);
        state->drop();
        resetRuntime();
        return true;
    } catch (const std::exception &exception) {
        state->drop();
        setError(error, exception.what());
        resetRuntime();
        return false;
    }
}

void exports_plugin_handle_event(uint32_t event_id,
                                 plugin_own_server_instance_t server,
                                 plugin_event_t *event, plugin_event_t *ret) {
    *ret = *event;
    std::vector<std::shared_ptr<ResourceState>> eventResources;
    std::shared_ptr<ResourceState> serverState;
    WitScopeGuard serverCleanup([&] {
        if (serverState)
            serverState->drop();
        else
            pumpkin_plugin_server_server_drop_own(
                pumpkin_plugin_server_own_server_t{server.__handle});
    });
    try {
        serverState = std::make_shared<ResourceState>(
            ResourceState{ResourceKind::Server, server.__handle, true});
        auto serverObject = wrapResourceObject(
            *jsRuntime, std::make_shared<ServerObject>(serverState));
        auto eventObject = makeEvent(*jsRuntime, event, &eventResources);
        Value args[] = {Value(static_cast<double>(event_id)),
                        std::move(serverObject), std::move(eventObject)};
        auto result = callExport("handleEvent", args, 3);
        returnEvent(*jsRuntime, result, event, ret, &eventResources);
    } catch (const std::exception &exception) {
        logPluginError(exception.what());
    }
    for (const auto &resource : eventResources)
        resource->transfer();
}

bool exports_plugin_handle_command(uint32_t command_id,
                                   plugin_own_command_sender_t sender,
                                   plugin_own_server_instance_t server,
                                   plugin_own_consumed_args_t args,
                                   int32_t *ret,
                                   plugin_command_error_t *error) {
    *ret = 0;
    std::memset(error, 0, sizeof(*error));
    std::shared_ptr<ResourceState> senderState;
    std::shared_ptr<ResourceState> serverState;
    std::shared_ptr<ResourceState> argsState;
    const auto dropResources = [&] {
        if (senderState)
            senderState->drop();
        else
            pumpkin_plugin_command_command_sender_drop_own(sender);
        if (serverState)
            serverState->drop();
        else
            pumpkin_plugin_server_server_drop_own(server);
        if (argsState)
            argsState->drop();
        else
            pumpkin_plugin_command_consumed_args_drop_own(args);
    };
    try {
        initializeRuntime();
        senderState = std::make_shared<ResourceState>(
            ResourceState{ResourceKind::CommandSender, sender.__handle, true});
        serverState = std::make_shared<ResourceState>(
            ResourceState{ResourceKind::Server, server.__handle, true});
        argsState = std::make_shared<ResourceState>(
            ResourceState{ResourceKind::ConsumedArgs, args.__handle, true});
        auto senderObject = wrapResourceObject(
            *jsRuntime, std::make_shared<CommandSenderObject>(senderState));
        auto serverObject = wrapResourceObject(
            *jsRuntime, std::make_shared<ServerObject>(serverState));
        auto argsObject = wrapResourceObject(
            *jsRuntime, std::make_shared<ConsumedArgsObject>(argsState));
        Value commandArgs[] = {Value(static_cast<double>(command_id)),
                               std::move(senderObject), std::move(serverObject),
                               std::move(argsObject)};
        const auto result = callExport("handleCommand", commandArgs, 4);
        if (!result.isNumber())
            throw std::runtime_error(
                "Plugin command handler did not return a number");
        *ret = static_cast<int32_t>(result.asNumber());
        senderState->drop();
        serverState->drop();
        argsState->drop();
        return true;
    } catch (const JSError &exception) {
        dropResources();
        if (!setCommandFailure(error, exception)) {
            auto message = exception.getMessage();
            if (message.empty() || message == "No message")
                message = exception.getStack();
            setCommandError(error,
                            message.empty() ? exception.what() : message);
        }
        return false;
    } catch (const std::exception &exception) {
        dropResources();
        setCommandError(error, exception.what());
        return false;
    } catch (...) {
        dropResources();
        setCommandError(error, "Unknown Static Hermes command failure");
        return false;
    }
}

void exports_plugin_handle_command_suggestion(
    uint32_t handler_id, plugin_own_command_sender_t sender,
    plugin_own_server_instance_t server, plugin_suggestion_request_t *request,
    plugin_command_suggestions_t *ret) {
    std::memset(ret, 0, sizeof(*ret));
    std::shared_ptr<ResourceState> senderState;
    std::shared_ptr<ResourceState> serverState;
    std::vector<std::shared_ptr<ResourceState>> tooltipResources;
    const auto dropSender = [&] {
        if (senderState)
            senderState->drop();
        else
            pumpkin_plugin_command_command_sender_drop_own(sender);
    };
    const auto dropServer = [&] {
        if (serverState)
            serverState->drop();
        else
            pumpkin_plugin_server_server_drop_own(server);
    };
    WitScopeGuard requestCleanup([&] {
        if (request)
            plugin_suggestion_request_free(request);
    });
    WitScopeGuard senderCleanup(dropSender);
    WitScopeGuard serverCleanup(dropServer);
    WitScopeGuard resultCleanup([&] {
        for (const auto &resource : tooltipResources)
            resource->drop();
        plugin_command_suggestions_free(ret);
        std::memset(ret, 0, sizeof(*ret));
    });

    try {
        if (!request)
            throw std::runtime_error("Missing command suggestion request");
        initializeRuntime();
        senderState = std::make_shared<ResourceState>(
            ResourceState{ResourceKind::CommandSender, sender.__handle, true});
        serverState = std::make_shared<ResourceState>(
            ResourceState{ResourceKind::Server, server.__handle, true});
        auto senderObject = wrapResourceObject(
            *jsRuntime, std::make_shared<CommandSenderObject>(senderState));
        auto serverObject = wrapResourceObject(
            *jsRuntime, std::make_shared<ServerObject>(serverState));

        Object requestObject(*jsRuntime);
        requestObject.setProperty(
            *jsRuntime, "input", jsString(*jsRuntime, wasiStringValue(request->input)));
        requestObject.setProperty(*jsRuntime, "cursor",
                                  Value(static_cast<double>(request->cursor)));
        requestObject.setProperty(*jsRuntime, "start",
                                  Value(static_cast<double>(request->start)));
        requestObject.setProperty(*jsRuntime, "remaining",
                                  jsString(*jsRuntime, wasiStringValue(request->remaining)));
        Value args[] = {Value(static_cast<double>(handler_id)),
                        std::move(senderObject), std::move(serverObject),
                        std::move(requestObject)};
        const auto result = callExport("handleCommandSuggestion", args, 4);
        if (!result.isObject())
            throw JSError(*jsRuntime,
                          "Plugin command suggestion handler must return an object");

        const auto suggestions = result.asObject(*jsRuntime);
        ret->start = wasiInputInteger<uint32_t>(
            *jsRuntime, suggestions.getProperty(*jsRuntime, "start"), "u32");
        ret->length = wasiInputInteger<uint32_t>(
            *jsRuntime, suggestions.getProperty(*jsRuntime, "length"), "u32");
        const auto values = suggestions.getProperty(*jsRuntime, "values")
                                .asObject(*jsRuntime)
                                .asArray(*jsRuntime);
        const auto valueCount = values.size(*jsRuntime);
        if (valueCount) {
            ret->values.ptr = static_cast<decltype(ret->values.ptr)>(
                std::calloc(valueCount, sizeof(*ret->values.ptr)));
            if (!ret->values.ptr)
                throw std::bad_alloc();
            ret->values.len = valueCount;
        }

        for (std::size_t index = 0; index < valueCount; ++index) {
            const auto suggestion = values.getValueAtIndex(*jsRuntime, index)
                                        .asObject(*jsRuntime);
            const auto tooltip = suggestion.getProperty(*jsRuntime, "tooltip");
            if (!tooltip.isUndefined() && !tooltip.isNull()) {
                const auto state = getWitResourceState(
                    *jsRuntime, tooltip, "text", "text-component");
                if (!state->owned)
                    throw JSError(*jsRuntime,
                                  "Command suggestion tooltip must be an owned text component");
                for (const auto &resource : tooltipResources) {
                    if (resource.get() == state.get())
                        throw JSError(*jsRuntime,
                                      "A command suggestion tooltip cannot be returned more than once");
                }
                try {
                    tooltipResources.push_back(state);
                } catch (...) {
                    state->drop();
                    throw;
                }
                ret->values.ptr[index].tooltip.is_some = true;
                ret->values.ptr[index].tooltip.val.__handle = state->handle;
            }
            copyString(&ret->values.ptr[index].value, *jsRuntime,
                       suggestion.getProperty(*jsRuntime, "value"));
        }

        for (const auto &resource : tooltipResources)
            resource->transfer();
        resultCleanup.release();
    } catch (const std::exception &exception) {
        logPluginError(exception.what());
    } catch (...) {
        logPluginError("Unknown Static Hermes command suggestion failure");
    }
}

