String jsString(Runtime &runtime, const std::string &value) {
    return String::createFromUtf8(runtime, value);
}

std::string utf8(Runtime &runtime, const Value &value) {
    return value.asString(runtime).utf8(runtime);
}

plugin_string_t wasiInputString(Runtime &runtime, const Value &value) {
    const auto text = utf8(runtime, value);
    plugin_string_t output{};
    plugin_string_dup_n(&output, text.data(), text.size());
    return output;
}

template <typename Integer>
Integer wasiInputInteger(Runtime &runtime, const Value &value,
                         const char *witType) {
    const double number = value.asNumber();
    if (!std::isfinite(number) || std::trunc(number) != number ||
        number < static_cast<double>(std::numeric_limits<Integer>::lowest()) ||
        number > static_cast<double>(std::numeric_limits<Integer>::max()))
        throw JSError(runtime, "Expected an integral value in the WIT " +
                                   std::string(witType) + " range");
    return static_cast<Integer>(number);
}

uint32_t wasiInputChar(Runtime &runtime, const Value &value) {
    const auto text = utf8(runtime, value);
    const auto invalid = [&]() { throw JSError(runtime, "Expected one Unicode scalar value for a WIT char"); };
    if (text.empty()) invalid();

    const auto first = static_cast<uint8_t>(text[0]);
    uint32_t codePoint = 0;
    std::size_t length = 0;
    if (first <= 0x7f) {
        codePoint = first;
        length = 1;
    } else if (first >= 0xc2 && first <= 0xdf) {
        codePoint = first & 0x1f;
        length = 2;
    } else if (first >= 0xe0 && first <= 0xef) {
        codePoint = first & 0x0f;
        length = 3;
    } else if (first >= 0xf0 && first <= 0xf4) {
        codePoint = first & 0x07;
        length = 4;
    } else {
        invalid();
    }
    if (text.size() != length) invalid();
    for (std::size_t index = 1; index < length; ++index) {
        const auto byte = static_cast<uint8_t>(text[index]);
        if ((byte & 0xc0) != 0x80) invalid();
        codePoint = (codePoint << 6) | (byte & 0x3f);
    }
    if ((length == 3 && codePoint < 0x800) || (length == 4 && codePoint < 0x10000) ||
        codePoint > 0x10ffff || (codePoint >= 0xd800 && codePoint <= 0xdfff)) {
        invalid();
    }
    return codePoint;
}

std::string wasiOutputChar(Runtime &runtime, uint32_t codePoint) {
    if (codePoint > 0x10ffff || (codePoint >= 0xd800 && codePoint <= 0xdfff)) {
        throw JSError(runtime, "Invalid Unicode scalar value from WIT char");
    }

    std::string text;
    if (codePoint <= 0x7f) {
        text.push_back(static_cast<char>(codePoint));
    } else if (codePoint <= 0x7ff) {
        text.push_back(static_cast<char>(0xc0 | (codePoint >> 6)));
        text.push_back(static_cast<char>(0x80 | (codePoint & 0x3f)));
    } else if (codePoint <= 0xffff) {
        text.push_back(static_cast<char>(0xe0 | (codePoint >> 12)));
        text.push_back(static_cast<char>(0x80 | ((codePoint >> 6) & 0x3f)));
        text.push_back(static_cast<char>(0x80 | (codePoint & 0x3f)));
    } else {
        text.push_back(static_cast<char>(0xf0 | (codePoint >> 18)));
        text.push_back(static_cast<char>(0x80 | ((codePoint >> 12) & 0x3f)));
        text.push_back(static_cast<char>(0x80 | ((codePoint >> 6) & 0x3f)));
        text.push_back(static_cast<char>(0x80 | (codePoint & 0x3f)));
    }
    return text;
}

std::string wasiStringValue(const plugin_string_t &value) {
    if (value.len == 0)
        return {};
    return std::string(reinterpret_cast<const char *>(value.ptr), value.len);
}

Function hostFunction(Runtime &runtime, const char *name, unsigned int arity,
                      HostFunctionType fn) {
    return Function::createFromHostFunction(
        runtime, PropNameID::forAscii(runtime, name), arity,
        std::move(fn));
}

Function dropResourceFunction(Runtime &runtime,
                              const std::shared_ptr<ResourceState> &state) {
    return hostFunction(runtime, "drop", 0,
                        [state](Runtime &, const Value &, const Value *,
                                std::size_t) -> Value {
                            state->drop();
                            return Value::undefined();
                        });
}

