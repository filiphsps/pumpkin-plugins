const char *commandArgumentStringTag(const pumpkin_plugin_command_arg_t &argument) {
    switch (argument.tag) {
    case PUMPKIN_PLUGIN_COMMAND_ARG_SIMPLE: return "simple";
    case PUMPKIN_PLUGIN_COMMAND_ARG_MSG: return "msg";
    case PUMPKIN_PLUGIN_COMMAND_ARG_ITEM: return "item";
    case PUMPKIN_PLUGIN_COMMAND_ARG_ITEM_PREDICATE: return "item-predicate";
    case PUMPKIN_PLUGIN_COMMAND_ARG_RESOURCE_LOCATION: return "resource-location";
    case PUMPKIN_PLUGIN_COMMAND_ARG_BLOCK: return "block";
    case PUMPKIN_PLUGIN_COMMAND_ARG_BLOCK_PREDICATE: return "block-predicate";
    case PUMPKIN_PLUGIN_COMMAND_ARG_PARTICLE: return "particle";
    case PUMPKIN_PLUGIN_COMMAND_ARG_DAMAGE_TYPE: return "damage-type";
    case PUMPKIN_PLUGIN_COMMAND_ARG_EFFECT: return "effect";
    case PUMPKIN_PLUGIN_COMMAND_ARG_ENCHANTMENT: return "enchantment";
    case PUMPKIN_PLUGIN_COMMAND_ARG_ADVANCEMENT: return "advancement";
    default: return nullptr;
    }
}

class ConsumedArgsObject final : public ResourceObject {
  public:
    explicit ConsumedArgsObject(std::shared_ptr<ResourceState> state)
        : state_(std::move(state)) {}
    const std::shared_ptr<ResourceState> &state() const override { return state_; }

    Value getResourceProperty(Runtime &runtime, const PropNameID &name) override {
        const auto key = propertyName(runtime, name);
        if (key == "getValue")
            return hostFunction(
                runtime, "getValue", 1,
                [state = state_](Runtime &rt, const Value &, const Value *args,
                                 std::size_t count) -> Value {
                    if (count < 1)
                        throw JSError(
                            rt,
                            "ConsumedArgs.getValue expects an argument name");
                    auto name = wasiInputString(rt, args[0]);
                    pumpkin_plugin_command_arg_t argument{};
                    pumpkin_plugin_command_method_consumed_args_get_value(
                        pumpkin_plugin_command_borrow_consumed_args_t{
                            state->handle},
                        &name, &argument);
                    plugin_string_free(&name);

                    Object result(rt);
                    if (const char *tag = commandArgumentStringTag(argument)) {
                        plugin_string_t *text = &argument.val.simple;
                        result.setProperty(rt, "tag", tag);
                        result.setProperty(
                            rt, "val", jsString(rt, wasiStringValue(*text)));
                    } else if (argument.tag == PUMPKIN_PLUGIN_COMMAND_ARG_NUM) {
                        result.setProperty(rt, "tag", "num");
                        Object numericResult(rt);
                        const auto &number = argument.val.num;
                        if (!number.is_err) {
                            numericResult.setProperty(rt, "tag", "ok");
                            numericResult.setProperty(
                                rt, "val",
                                commandNumberValue(rt, number.val.ok));
                        } else {
                            numericResult.setProperty(rt, "tag", "err");
                            Object bounds(rt);
                            const auto &error = number.val.err;
                            const bool lower =
                                error.tag ==
                                PUMPKIN_PLUGIN_COMMAND_NOT_IN_BOUNDS_LOWER_BOUND;
                            bounds.setProperty(rt, "tag",
                                               lower ? "lower-bound"
                                                     : "upper-bound");
                            Array values(rt, 2);
                            const auto &pair = lower ? error.val.lower_bound
                                                     : error.val.upper_bound;
                            values.setValueAtIndex(
                                rt, 0, commandNumberValue(rt, pair.f0));
                            values.setValueAtIndex(
                                rt, 1, commandNumberValue(rt, pair.f1));
                            bounds.setProperty(rt, "val", std::move(values));
                            numericResult.setProperty(rt, "val",
                                                      std::move(bounds));
                        }
                        result.setProperty(rt, "val", std::move(numericResult));
                    } else if (argument.tag ==
                               PUMPKIN_PLUGIN_COMMAND_ARG_BOOL) {
                        result.setProperty(rt, "tag", "bool");
                        result.setProperty(rt, "val", argument.val.bool_);
                    } else if (argument.tag ==
                               PUMPKIN_PLUGIN_COMMAND_ARG_TIME) {
                        result.setProperty(rt, "tag", "time");
                        result.setProperty(
                            rt, "val", static_cast<double>(argument.val.time));
                    } else {
                        pumpkin_plugin_command_arg_free(&argument);
                        throw JSError(rt, "Static Hermes does not support this "
                                          "Pumpkin command argument type");
                    }
                    pumpkin_plugin_command_arg_free(&argument);
                    return result;
                });
        if (key == "drop") return dropResourceFunction(runtime, state_);
        return Value::undefined();
    }

  private:
    static Value
    commandNumberValue(Runtime &runtime,
                       const pumpkin_plugin_command_number_t &number) {
        Object result(runtime);
        switch (number.tag) {
        case PUMPKIN_PLUGIN_COMMAND_NUMBER_FLOAT64:
            result.setProperty(runtime, "tag", "float64");
            result.setProperty(runtime, "val", Value(number.val.float64));
            break;
        case PUMPKIN_PLUGIN_COMMAND_NUMBER_FLOAT32:
            result.setProperty(runtime, "tag", "float32");
            result.setProperty(runtime, "val",
                               Value(static_cast<double>(number.val.float32)));
            break;
        case PUMPKIN_PLUGIN_COMMAND_NUMBER_INT32:
            result.setProperty(runtime, "tag", "int32");
            result.setProperty(runtime, "val",
                               Value(static_cast<double>(number.val.int32)));
            break;
        case PUMPKIN_PLUGIN_COMMAND_NUMBER_INT64:
            result.setProperty(runtime, "tag", "int64");
            result.setProperty(runtime, "val",
                               BigInt::fromInt64(runtime, number.val.int64));
            break;
        default:
            throw JSError(runtime, "Unknown Pumpkin command number variant");
        }
        return result;
    }

    std::shared_ptr<ResourceState> state_;
};

std::pair<std::string, std::string>
resourceIdentity(const ResourceState &state) {
    if (state.kind == ResourceKind::Wit)
        return {state.interfaceName, state.resourceName};

    switch (state.kind) {
    case ResourceKind::Context: return {"context", "context"};
    case ResourceKind::Server: return {"server", "server"};
    case ResourceKind::Entity: return {"world", "entity"};
    case ResourceKind::ChunkBuffer: return {"world", "chunk-buffer"};
    case ResourceKind::Player: return {"player", "player"};
    case ResourceKind::World: return {"world", "world"};
    case ResourceKind::JavaPlayer: return {"player", "java-player"};
    case ResourceKind::Command: return {"command", "command"};
    case ResourceKind::CommandNode: return {"command", "command-node"};
    case ResourceKind::CommandSender: return {"command", "command-sender"};
    case ResourceKind::ConsumedArgs: return {"command", "consumed-args"};
    case ResourceKind::Text: return {"text", "text-component"};
    case ResourceKind::Wit: break;
    }
    return {};
}

std::shared_ptr<ResourceState>
getWitResourceState(Runtime &runtime, const Value &value,
                    const std::string &interfaceName,
                    const std::string &resourceName,
                    const std::string &packageName) {
    auto resource = std::dynamic_pointer_cast<ResourceObject>(
        nativeResource(runtime, value));
    if (!resource)
        throw JSError(runtime, "Expected a Pumpkin resource");

    const auto state = resource->state();
    const auto [actualInterface, actualResource] = resourceIdentity(*state);
    if (!state->valid)
        throw JSError(runtime, "Cannot use a disposed or transferred resource");
    if (actualInterface != interfaceName || actualResource != resourceName ||
        (!packageName.empty() && state->packageName != packageName))
        throw JSError(runtime, "Expected " + interfaceName + "." + resourceName +
                                   " resource, received " + actualInterface +
                                   "." + actualResource);
    return state;
}

Object exportsObject(Runtime &runtime) {
    return runtime.global().getPropertyAsObject(runtime, "__pumpkinPlugin");
}

Value callExport(const char *name, const Value *args, std::size_t count) {
    if (!jsRuntime)
        throw std::runtime_error("Static Hermes Runtime is not initialized");
    auto exports = exportsObject(*jsRuntime);
    return exports.getPropertyAsFunction(*jsRuntime, name)
        .call(*jsRuntime, args, count);
}

void initializeRuntime() {
    if (jsRuntime)
        return;
    staticRuntime = _sh_init(hermes::vm::RuntimeConfig{});
    jsRuntime = _sh_get_hermes_runtime(staticRuntime);
    bool initialized = false;
    const char *evaluationStage = "embedded plugin bytecode";
    std::string evaluationDiagnostic;
    try {
        jsRuntime->evaluateJavaScript(
            std::make_shared<PluginBundleBuffer>(), "plugin_bundle.hbc");
        initialized = true;
    } catch (const JSIException &error) {
        evaluationDiagnostic = std::string(evaluationStage) + ": " + error.what();
    } catch (const std::exception &error) {
        evaluationDiagnostic = std::string(evaluationStage) + ": " + error.what();
    } catch (...) {
        evaluationDiagnostic = std::string(evaluationStage) + ": unknown exception";
    }
    if (!initialized) {
        std::string diagnostic;
        try {
            auto value = jsRuntime->global().getProperty(
                *jsRuntime, "__pumpkinPluginInitError");
            if (value.isString())
                diagnostic = utf8(*jsRuntime, value);
        } catch (...) {
        }
        if (diagnostic.empty())
            diagnostic = evaluationDiagnostic.empty()
                             ? "Hermes could not evaluate the plugin runtime"
                             : evaluationDiagnostic;
        _sh_done(staticRuntime);
        jsRuntime = nullptr;
        staticRuntime = nullptr;
        throw std::runtime_error(
            diagnostic.empty()
                ? "Static Hermes failed while evaluating the plugin bundle"
                : "Static Hermes failed while evaluating the plugin bundle: " +
                      diagnostic);
    }

    Object host(*jsRuntime);
    Object loggingApi(*jsRuntime);
    loggingApi.setProperty(
        *jsRuntime, "log",
        hostFunction(*jsRuntime, "log", 2,
                     [](Runtime &rt, const Value &, const Value *args,
                        std::size_t count) -> Value {
                         if (count < 2)
                             return Value::undefined();
                         const auto levelName = utf8(rt, args[0]);
                         const auto messageText = utf8(rt, args[1]);
                         pumpkin_plugin_logging_level_t level =
                             PUMPKIN_PLUGIN_LOGGING_LEVEL_INFO;
                         if (levelName == "trace")
                             level = PUMPKIN_PLUGIN_LOGGING_LEVEL_TRACE;
                         else if (levelName == "debug")
                             level = PUMPKIN_PLUGIN_LOGGING_LEVEL_DEBUG;
                         else if (levelName == "warn")
                             level = PUMPKIN_PLUGIN_LOGGING_LEVEL_WARN;
                         else if (levelName == "error")
                             level = PUMPKIN_PLUGIN_LOGGING_LEVEL_ERROR;
                         plugin_string_t message{};
                         plugin_string_dup_n(&message, messageText.data(),
                                             messageText.size());
                         pumpkin_plugin_logging_log(level, &message);
                         plugin_string_free(&message);
                         return Value::undefined();
                     }));
    host.setProperty(*jsRuntime, "logging", std::move(loggingApi));

    Object schedulerApi(*jsRuntime);
    schedulerApi.setProperty(
        *jsRuntime, "scheduleDelayedTask",
        hostFunction(
            *jsRuntime, "scheduleDelayedTask", 2,
            [](Runtime &rt, const Value &, const Value *args,
               std::size_t count) -> Value {
                if (count < 2)
                    throw JSError(rt,
                                  "scheduleDelayedTask expects two arguments");
                const auto handler = static_cast<uint32_t>(args[0].asNumber());
                const auto delay = args[1].asBigInt(rt).asUint64(rt);
                return Value(static_cast<double>(
                    pumpkin_plugin_scheduler_schedule_delayed_task(handler,
                                                                   delay)));
            }));
    schedulerApi.setProperty(
        *jsRuntime, "scheduleRepeatingTask",
        hostFunction(
            *jsRuntime, "scheduleRepeatingTask", 3,
            [](Runtime &rt, const Value &, const Value *args,
               std::size_t count) -> Value {
                if (count < 3)
                    throw JSError(
                        rt, "scheduleRepeatingTask expects three arguments");
                const auto handler = static_cast<uint32_t>(args[0].asNumber());
                const auto delay = args[1].asBigInt(rt).asUint64(rt);
                const auto period = args[2].asBigInt(rt).asUint64(rt);
                return Value(static_cast<double>(
                    pumpkin_plugin_scheduler_schedule_repeating_task(
                        handler, delay, period)));
            }));
    schedulerApi.setProperty(
        *jsRuntime, "cancelTask",
        hostFunction(*jsRuntime, "cancelTask", 1,
                     [](Runtime &, const Value &, const Value *args,
                        std::size_t) -> Value {
                         pumpkin_plugin_scheduler_cancel_task(
                             static_cast<uint32_t>(args[0].asNumber()));
                         return Value::undefined();
                     }));
    host.setProperty(*jsRuntime, "scheduler", std::move(schedulerApi));

    Object commandApi(*jsRuntime);
    Object commandResourceApi(*jsRuntime);
    commandResourceApi.setProperty(
        *jsRuntime, "constructor",
        hostFunction(
            *jsRuntime, "constructor", 2,
            [](Runtime &rt, const Value &, const Value *args,
               std::size_t count) -> Value {
                if (count < 2)
                    throw JSError(
                        rt,
                        "Command constructor expects names and a description");
                auto namesObject = args[0].asObject(rt);
                auto namesArray = namesObject.asArray(rt);
                plugin_list_string_t names{};
                names.len = namesArray.size(rt);
                if (names.len) {
                    names.ptr = static_cast<plugin_string_t *>(
                        std::calloc(names.len, sizeof(plugin_string_t)));
                    if (!names.ptr)
                        throw std::bad_alloc();
                    for (std::size_t index = 0; index < names.len; ++index)
                        names.ptr[index] = wasiInputString(
                            rt, namesArray.getValueAtIndex(rt, index));
                }
                auto description = wasiInputString(rt, args[1]);
                auto command = pumpkin_plugin_command_constructor_command(
                    &names, &description);
                plugin_list_string_free(&names);
                plugin_string_free(&description);
                return makeCommand(rt, command);
            }));
    commandApi.setProperty(*jsRuntime, "command",
                           std::move(commandResourceApi));
    Object commandNodeApi(*jsRuntime);
    commandNodeApi.setProperty(
        *jsRuntime, "literal",
        hostFunction(
            *jsRuntime, "literal", 1,
            [](Runtime &rt, const Value &, const Value *args,
               std::size_t count) -> Value {
                if (count < 1)
                    throw JSError(rt, "CommandNode.literal expects a name");
                auto name = wasiInputString(rt, args[0]);
                auto node =
                    pumpkin_plugin_command_static_command_node_literal(&name);
                plugin_string_free(&name);
                return makeCommandNode(rt, node);
            }));
    commandNodeApi.setProperty(
        *jsRuntime, "argument",
        hostFunction(
            *jsRuntime, "argument", 2,
            [](Runtime &rt, const Value &, const Value *args,
               std::size_t count) -> Value {
                if (count < 2)
                    throw JSError(
                        rt, "CommandNode.argument expects a name and type");
                auto name = wasiInputString(rt, args[0]);
                auto type = commandArgumentType(rt, args[1]);
                auto node = pumpkin_plugin_command_static_command_node_argument(
                    &name, &type);
                plugin_string_free(&name);
                return makeCommandNode(rt, node);
            }));
    commandApi.setProperty(*jsRuntime, "commandNode",
                           std::move(commandNodeApi));
    host.setProperty(*jsRuntime, "command", std::move(commandApi));

    Object textApi(*jsRuntime);
    Object textComponentApi(*jsRuntime);
    textComponentApi.setProperty(
        *jsRuntime, "text",
        hostFunction(
            *jsRuntime, "text", 1,
            [](Runtime &rt, const Value &, const Value *args,
               std::size_t count) -> Value {
                if (count < 1)
                    throw JSError(rt, "TextComponent.text expects text");
                auto text = wasiInputString(rt, args[0]);
                auto component =
                    pumpkin_plugin_text_static_text_component_text(&text);
                plugin_string_free(&text);
                return makeText(rt, component);
            }));
    textComponentApi.setProperty(
        *jsRuntime, "fromLegacyString",
        hostFunction(
            *jsRuntime, "fromLegacyString", 1,
            [](Runtime &rt, const Value &, const Value *args,
               std::size_t count) -> Value {
                if (count < 1)
                    throw JSError(
                        rt, "TextComponent.fromLegacyString expects text");
                auto text = wasiInputString(rt, args[0]);
                auto component =
                    pumpkin_plugin_text_static_text_component_from_legacy_string(
                        &text);
                plugin_string_free(&text);
                return makeText(rt, component);
            }));
    textApi.setProperty(*jsRuntime, "textComponent",
                        std::move(textComponentApi));
    host.setProperty(*jsRuntime, "text", std::move(textApi));

    Object uuidApi(*jsRuntime);
    uuidApi.setProperty(
        *jsRuntime, "generate",
        hostFunction(*jsRuntime, "generate", 0,
                     [](Runtime &rt, const Value &, const Value *,
                        std::size_t) -> Value {
                         pumpkin_plugin_uuid_uuid_t uuid{};
                         pumpkin_plugin_uuid_generate(&uuid);
                         Object result(rt);
                         result.setProperty(rt, "high",
                                            BigInt::fromUint64(rt, uuid.high));
                         result.setProperty(rt, "low",
                                            BigInt::fromUint64(rt, uuid.low));
                         return result;
                     }));
    uuidApi.setProperty(
        *jsRuntime, "parse",
        hostFunction(*jsRuntime, "parse", 1,
                     [](Runtime &rt, const Value &, const Value *args,
                        std::size_t count) -> Value {
                         if (count < 1)
                             throw JSError(rt, "Uuid.parse expects a string");
                         auto input = wasiInputString(rt, args[0]);
                         pumpkin_plugin_uuid_uuid_t uuid{};
                         const auto valid =
                             pumpkin_plugin_uuid_parse(&input, &uuid);
                         plugin_string_free(&input);
                         if (!valid)
                             return Value::undefined();
                         Object result(rt);
                         result.setProperty(rt, "high",
                                            BigInt::fromUint64(rt, uuid.high));
                         result.setProperty(rt, "low",
                                            BigInt::fromUint64(rt, uuid.low));
                         return result;
                     }));
    uuidApi.setProperty(
        *jsRuntime, "toString",
        hostFunction(
            *jsRuntime, "toString", 1,
            [](Runtime &rt, const Value &, const Value *args,
               std::size_t count) -> Value {
                if (count < 1 || !args[0].isObject())
                    throw JSError(rt, "Uuid.toString expects a UUID record");
                auto value = args[0].asObject(rt);
                pumpkin_plugin_uuid_uuid_t uuid{
                    value.getProperty(rt, "high").asBigInt(rt).asUint64(rt),
                    value.getProperty(rt, "low").asBigInt(rt).asUint64(rt)};
                plugin_string_t output{};
                pumpkin_plugin_uuid_to_string(&uuid, &output);
                auto result = jsString(rt, wasiStringValue(output));
                plugin_string_free(&output);
                return result;
            }));
    host.setProperty(*jsRuntime, "uuid", std::move(uuidApi));

    Object worldApi(*jsRuntime);
    worldApi.setProperty(
        *jsRuntime, "blockStateToInfo",
        hostFunction(
            *jsRuntime, "blockStateToInfo", 1,
            [](Runtime &rt, const Value &, const Value *args,
               std::size_t count) -> Value {
                if (count < 1)
                    throw JSError(rt,
                                  "blockStateToInfo expects a block state id");
                pumpkin_plugin_world_block_state_info_t info{};
                if (!pumpkin_plugin_world_block_state_to_info(
                        static_cast<uint16_t>(args[0].asNumber()), &info))
                    return Value::undefined();
                Object result(rt);
                result.setProperty(rt, "name",
                                   jsString(rt, wasiStringValue(info.name)));
                Array properties(rt, info.properties.len);
                for (std::size_t index = 0; index < info.properties.len;
                     ++index) {
                    Array pair(rt, 2);
                    pair.setValueAtIndex(
                        rt, 0,
                        jsString(rt, wasiStringValue(
                                         info.properties.ptr[index].f0)));
                    pair.setValueAtIndex(
                        rt, 1,
                        jsString(rt, wasiStringValue(
                                         info.properties.ptr[index].f1)));
                    properties.setValueAtIndex(rt, index, std::move(pair));
                }
                result.setProperty(rt, "properties", std::move(properties));
                pumpkin_plugin_world_block_state_info_free(&info);
                return result;
            }));
    host.setProperty(*jsRuntime, "world", std::move(worldApi));
    installGeneratedWitApiFunctions(*jsRuntime, host);
    /* <PUMPKIN_WASI_INITIALIZATION> */
    jsRuntime->global().setProperty(*jsRuntime, "__pumpkinHost",
                                    std::move(host));
}

void resetRuntime() {
    jsRuntime = nullptr;
    if (staticRuntime) {
        _sh_done(staticRuntime);
        staticRuntime = nullptr;
    }
}

void setError(plugin_string_t *error, const std::string &message) {
    plugin_string_dup_n(error, message.data(), message.size());
}

void logPluginError(const std::string &message) {
    plugin_string_t text{};
    plugin_string_dup_n(&text, message.data(), message.size());
    pumpkin_plugin_logging_log(PUMPKIN_PLUGIN_LOGGING_LEVEL_ERROR, &text);
    plugin_string_free(&text);
}

void setCommandError(plugin_command_error_t *error,
                     const std::string &message) {
    error->tag = PUMPKIN_PLUGIN_COMMAND_COMMAND_ERROR_INVALID_CONSUMPTION;
    error->val.invalid_consumption.is_some = true;
    plugin_string_dup_n(&error->val.invalid_consumption.val, message.data(),
                        message.size());
}

bool setCommandFailure(plugin_command_error_t *error,
                       const JSError &exception) {
    try {
        const auto &thrown = exception.value();
        if (!thrown.isObject())
            return false;
        auto object = thrown.asObject(*jsRuntime);
        const auto tag = object.getProperty(*jsRuntime, "tag");
        if (!tag.isString() || utf8(*jsRuntime, tag) != "command-failed")
            return false;
        auto text = std::dynamic_pointer_cast<TextObject>(
            nativeResource(*jsRuntime, object.getProperty(*jsRuntime, "val")));
        if (!text || !text->state()->owned)
            return false;
        error->tag = PUMPKIN_PLUGIN_COMMAND_COMMAND_ERROR_COMMAND_FAILED;
        error->val.command_failed.__handle = text->state()->handle;
        text->state()->transfer();
        return true;
    } catch (...) {
        return false;
    }
}

void copyString(plugin_string_t *target, Runtime &runtime, const Value &value) {
    const auto text = utf8(runtime, value);
    plugin_string_dup_n(target, text.data(), text.size());
}

void copyStringList(plugin_list_string_t *target, Runtime &runtime,
                    const Value &value) {
    if (value.isUndefined() || value.isNull())
        return;
    auto list = value.asObject(runtime).asArray(runtime);
    target->len = list.size(runtime);
    if (!target->len)
        return;
    target->ptr = static_cast<plugin_string_t *>(
        std::calloc(target->len, sizeof(plugin_string_t)));
    if (!target->ptr)
        throw std::bad_alloc();
    for (std::size_t i = 0; i < target->len; ++i)
        copyString(&target->ptr[i], runtime, list.getValueAtIndex(runtime, i));
}

std::string eventName(pumpkin_plugin_event_event_type_t tag) {
    for (const auto &entry : pumpkin_static_api::eventTypes)
        if (tag == entry.value)
            return std::string(entry.name);
    return "unknown-event";
}

/* <PUMPKIN_WASI_RUNTIME> */

Object makeEvent(Runtime &runtime, plugin_event_t *event,
                 std::vector<std::shared_ptr<ResourceState>> *ownedResources) {
    Object result(runtime);
    const auto name = eventName(event->tag);
    result.setProperty(runtime, "tag", jsString(runtime, name));
    Object data(runtime);
    /* <PUMPKIN_WIT_EVENT_DISPATCH> */
    result.setProperty(runtime, "val", std::move(data));
    return result;
}

void returnEvent(Runtime &rt, const Value &value, plugin_event_t *event,
                 plugin_event_t *ret,
                 std::vector<std::shared_ptr<ResourceState>> *eventResources) {
    /* <PUMPKIN_WIT_EVENT_RESULT> */
}

