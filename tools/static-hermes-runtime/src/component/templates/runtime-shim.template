                                                   const std::string &packageName = "");

/* <PUMPKIN_WIT_SIMPLE_METHODS> */

std::shared_ptr<HostObject> nativeResource(Runtime &runtime,
                                           const Value &value) {
    if (!value.isObject())
        throw JSError(runtime, "Expected a Pumpkin resource");
    auto object = value.asObject(runtime);
    for (unsigned int depth = 0; depth < 16; ++depth) {
        auto wrapped = object.getProperty(runtime, "__staticHermesResource");
        if (!wrapped.isObject())
            return object.getHostObject(runtime);
        object = wrapped.asObject(runtime);
    }
    throw JSError(runtime, "Pumpkin resource wrapper nesting is too deep");
}

std::shared_ptr<ResourceState> ownedCommandNodeState(Runtime &runtime,
                                                     const Value &value,
                                                     const char *errorMessage) {
    auto resource = std::dynamic_pointer_cast<ResourceObject>(
        nativeResource(runtime, value));
    const auto state = resource ? resource->state() : nullptr;
    const bool isCommandNode =
        state && (state->kind == ResourceKind::CommandNode ||
                  (state->kind == ResourceKind::Wit &&
                   state->interfaceName == "command" &&
                   state->resourceName == "command-node"));
    if (!isCommandNode || !state->owned || !state->valid)
        throw JSError(runtime, errorMessage);
    return state;
}

std::string propertyName(Runtime &runtime, const PropNameID &name) {
    return name.utf8(runtime);
}

Value ResourceObject::get(Runtime &runtime, const PropNameID &name) {
    const auto key = propertyName(runtime, name);
    if (key == "__isValid")
        return Value(state()->valid);
    const auto disposeSymbol = runtime.global()
                                   .getPropertyAsObject(runtime, "Symbol")
                                   .getProperty(runtime, "dispose");
    const bool isDispose =
        disposeSymbol.isSymbol() &&
        PropNameID::compare(
            runtime, name,
            PropNameID::forSymbol(runtime, disposeSymbol.asSymbol(runtime)));
    if (isDispose)
        return hostFunction(runtime, "dispose", 0,
                            [resource = state()](Runtime &, const Value &,
                                                 const Value *,
                                                 std::size_t) -> Value {
                                resource->drop();
                                return Value::undefined();
                            });
    return getResourceProperty(runtime, name);
}

Object wrapResourceObject(Runtime &runtime,
                          std::shared_ptr<ResourceObject> resource) {
    auto hostObject = Object::createFromHostObject(runtime, std::move(resource));
    auto wrap = runtime.global().getPropertyAsFunction(
        runtime, "__staticHermesWrapResource");
    Value value = wrap.call(runtime, hostObject);
    return value.asObject(runtime);
}

class WitResourceObject final : public ResourceObject {
  public:
    explicit WitResourceObject(std::shared_ptr<ResourceState> state)
        : state_(std::move(state)) {}
    const std::shared_ptr<ResourceState> &state() const override { return state_; }

    Value getResourceProperty(Runtime &runtime, const PropNameID &name) override {
        const auto key = propertyName(runtime, name);
        auto generated = state_->packageName.rfind("wasi:", 0) == 0
                             ? generatedWasiResourceMethod(
                                   runtime, state_->packageName,
                                   state_->interfaceName, state_->resourceName,
                                   key, state_)
                             : generatedWitSimpleMethod(
                                   runtime, state_->interfaceName,
                                   state_->resourceName, key, state_);
        if (!generated.isUndefined())
            return generated;
        if (key == "drop") return dropResourceFunction(runtime, state_);
        return Value::undefined();
    }

  private:
    std::shared_ptr<ResourceState> state_;
};

std::shared_ptr<ResourceObject>
makeWitResourceObject(std::shared_ptr<ResourceState> state) {
    return std::make_shared<WitResourceObject>(std::move(state));
}

class CommandNodeObject final : public ResourceObject {
  public:
    explicit CommandNodeObject(std::shared_ptr<ResourceState> state)
        : state_(std::move(state)) {}
    const std::shared_ptr<ResourceState> &state() const override { return state_; }

    Value getResourceProperty(Runtime &runtime, const PropNameID &name) override {
        const auto key = propertyName(runtime, name);
        auto generated = generatedWitSimpleMethod(runtime, "command",
                                                  "command-node", key, state_);
        if (!generated.isUndefined())
            return generated;
        if (key == "then")
            return hostFunction(
                runtime, "then", 1,
                [state = state_](Runtime &rt, const Value &, const Value *args,
                                 std::size_t count) -> Value {
                    if (count < 1)
                        throw JSError(rt,
                                      "CommandNode.then expects a child node");
                    auto childState = ownedCommandNodeState(
                        rt, args[0], "CommandNode.then expects an owned child node");
                    pumpkin_plugin_command_method_command_node_then(
                        pumpkin_plugin_command_borrow_command_node_t{
                            state->handle},
                        pumpkin_plugin_command_own_command_node_t{
                            childState->handle});
                    childState->transfer();
                    return Value::undefined();
                });
        if (key == "executeWithHandlerId" || key == "suggestWithHandlerId" ||
            key == "requireWithHandlerId")
            return hostFunction(
                runtime, key.c_str(), 1,
                [state = state_, key](Runtime &rt, const Value &,
                                      const Value *args,
                                      std::size_t count) -> Value {
                    if (count < 1)
                        throw JSError(
                            rt, "CommandNode handler method expects an id");
                    const auto id = static_cast<uint32_t>(args[0].asNumber());
                    const auto handle =
                        pumpkin_plugin_command_borrow_command_node_t{
                            state->handle};
                    if (key == "executeWithHandlerId")
                        pumpkin_plugin_command_method_command_node_execute_with_handler_id(
                            handle, id);
                    else if (key == "suggestWithHandlerId")
                        pumpkin_plugin_command_method_command_node_suggest_with_handler_id(
                            handle, id);
                    else
                        pumpkin_plugin_command_method_command_node_require_with_handler_id(
                            handle, id);
                    return Value::undefined();
                });
        if (key == "drop") return dropResourceFunction(runtime, state_);
        return Value::undefined();
    }

  private:
    std::shared_ptr<ResourceState> state_;
};

class CommandObject final : public ResourceObject {
  public:
    explicit CommandObject(std::shared_ptr<ResourceState> state)
        : state_(std::move(state)) {}
    const std::shared_ptr<ResourceState> &state() const override { return state_; }

    Value getResourceProperty(Runtime &runtime, const PropNameID &name) override {
        const auto key = propertyName(runtime, name);
        auto generated = generatedWitSimpleMethod(runtime, "command", "command",
                                                  key, state_);
        if (!generated.isUndefined())
            return generated;
        if (key == "then")
            return hostFunction(
                runtime, "then", 1,
                [state = state_](Runtime &rt, const Value &, const Value *args,
                                 std::size_t count) -> Value {
                    if (count < 1)
                        throw JSError(rt, "Command.then expects a child node");
                    auto childState = ownedCommandNodeState(
                        rt, args[0], "Command.then expects an owned child node");
                    pumpkin_plugin_command_method_command_then(
                        pumpkin_plugin_command_borrow_command_t{state->handle},
                        pumpkin_plugin_command_own_command_node_t{
                            childState->handle});
                    childState->transfer();
                    return Value::undefined();
                });
        if (key == "executeWithHandlerId")
            return hostFunction(
                runtime, "executeWithHandlerId", 1,
                [state = state_](Runtime &rt, const Value &, const Value *args,
                                 std::size_t count) -> Value {
                    if (count < 1)
                        throw JSError(
                            rt, "Command.executeWithHandlerId expects an id");
                    pumpkin_plugin_command_method_command_execute_with_handler_id(
                        pumpkin_plugin_command_borrow_command_t{state->handle},
                        static_cast<uint32_t>(args[0].asNumber()));
                    return Value::undefined();
                });
        if (key == "drop") return dropResourceFunction(runtime, state_);
        return Value::undefined();
    }

  private:
    std::shared_ptr<ResourceState> state_;
};

