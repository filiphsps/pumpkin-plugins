class ContextObject final : public ResourceObject {
  public:
    explicit ContextObject(std::shared_ptr<ResourceState> state)
        : state_(std::move(state)) {}
    const std::shared_ptr<ResourceState> &state() const override { return state_; }

    Value getResourceProperty(Runtime &runtime, const PropNameID &name) override {
        const auto key = propertyName(runtime, name);
        auto generated = generatedWitSimpleMethod(runtime, "context", "context",
                                                  key, state_);
        if (!generated.isUndefined())
            return generated;
        if (key == "registerPermission")
            return hostFunction(
                runtime, "registerPermission", 1,
                [state = state_](Runtime &rt, const Value &, const Value *args,
                                 std::size_t count) -> Value {
                    if (count < 1 || !args[0].isObject())
                        throw JSError(rt, "Context.registerPermission expects "
                                          "a permission record");
                    auto value = args[0].asObject(rt);
                    auto permissionTag =
                        utf8(rt, value.getProperty(rt, "default")
                                     .asObject(rt)
                                     .getProperty(rt, "tag"));
                    pumpkin_plugin_context_permission_t permission{};
                    permission.node =
                        wasiInputString(rt, value.getProperty(rt, "node"));
                    permission.description = wasiInputString(
                        rt, value.getProperty(rt, "description"));
                    if (permissionTag == "allow")
                        permission.default_.tag =
                            PUMPKIN_PLUGIN_PERMISSION_PERMISSION_DEFAULT_ALLOW;
                    else if (permissionTag == "deny")
                        permission.default_.tag =
                            PUMPKIN_PLUGIN_PERMISSION_PERMISSION_DEFAULT_DENY;
                    else if (permissionTag == "op") {
                        permission.default_.tag =
                            PUMPKIN_PLUGIN_PERMISSION_PERMISSION_DEFAULT_OP;
                        const auto level =
                            utf8(rt, value.getProperty(rt, "default")
                                         .asObject(rt)
                                         .getProperty(rt, "val"));
                        static const char *levels[] = {"zero", "one", "two",
                                                       "three", "four"};
                        bool found = false;
                        for (uint8_t index = 0;
                             index < sizeof(levels) / sizeof(levels[0]);
                             ++index) {
                            if (level == levels[index]) {
                                permission.default_.val.op = index;
                                found = true;
                                break;
                            }
                        }
                        if (!found) {
                            pumpkin_plugin_permission_permission_free(
                                &permission);
                            throw JSError(rt,
                                          "Context.registerPermission received "
                                          "an unknown operator level");
                        }
                    } else {
                        pumpkin_plugin_permission_permission_free(&permission);
                        throw JSError(rt, "Context.registerPermission received "
                                          "an unknown default");
                    }
                    auto children = value.getProperty(rt, "children");
                    if (!children.isUndefined() && !children.isNull()) {
                        auto list = children.asObject(rt).asArray(rt);
                        permission.children.len = list.size(rt);
                        if (permission.children.len) {
                            permission.children.ptr = static_cast<
                                pumpkin_plugin_permission_permission_child_t
                                    *>(std::calloc(
                                permission.children.len,
                                sizeof(
                                    pumpkin_plugin_permission_permission_child_t)));
                            if (!permission.children.ptr) {
                                pumpkin_plugin_permission_permission_free(
                                    &permission);
                                throw std::bad_alloc();
                            }
                            for (std::size_t index = 0;
                                 index < permission.children.len; ++index) {
                                auto child =
                                    list.getValueAtIndex(rt, index).asObject(
                                        rt);
                                permission.children.ptr[index].node =
                                    wasiInputString(
                                        rt, child.getProperty(rt, "node"));
                                permission.children.ptr[index].value =
                                    child.getProperty(rt, "value").getBool();
                            }
                        }
                    }
                    plugin_string_t error{};
                    const auto ok =
                        pumpkin_plugin_context_method_context_register_permission(
                            pumpkin_plugin_context_borrow_context_t{
                                state->handle},
                            &permission, &error);
                    pumpkin_plugin_permission_permission_free(&permission);
                    if (!ok) {
                        auto message = wasiStringValue(error);
                        plugin_string_free(&error);
                        throw JSError(rt,
                                      "Context.registerPermission failed: " +
                                          message);
                    }
                    plugin_string_free(&error);
                    return Value::undefined();
                });
        if (key == "drop") return dropResourceFunction(runtime, state_);
        return Value::undefined();
    }

  private:
    std::shared_ptr<ResourceState> state_;
};

