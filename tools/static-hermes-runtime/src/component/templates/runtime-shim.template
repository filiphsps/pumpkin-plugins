static const char *generationPhaseName(plugin_generation_phase_t phase) {
    switch (phase) {
    case PUMPKIN_PLUGIN_WORLD_GENERATION_PHASE_BIOMES: return "biomes";
    case PUMPKIN_PLUGIN_WORLD_GENERATION_PHASE_NOISE: return "noise";
    case PUMPKIN_PLUGIN_WORLD_GENERATION_PHASE_SURFACE: return "surface";
    case PUMPKIN_PLUGIN_WORLD_GENERATION_PHASE_FEATURES: return "features";
    default: throw std::runtime_error("Unknown Pumpkin generation phase");
    }
}

void exports_plugin_handle_generate_phase(
    uint32_t generatorId, plugin_generation_phase_t phase,
    plugin_own_chunk_buffer_t chunk) {
    std::shared_ptr<ResourceState> chunkState;
    WitScopeGuard chunkCleanup([&] {
        if (chunkState)
            chunkState->drop();
        else
            pumpkin_plugin_world_chunk_buffer_drop_own(
                pumpkin_plugin_world_own_chunk_buffer_t{chunk.__handle});
    });

    try {
        initializeRuntime();
        chunkState = makeOwnedWitCallbackResource(
            chunk.__handle, "world", "chunk-buffer");
        auto chunkObject = wrapResourceObject(
            *jsRuntime, makeWitResourceObject(chunkState));
        Value args[] = {Value(static_cast<double>(generatorId)),
                        jsString(*jsRuntime, generationPhaseName(phase)),
                        Value(std::move(chunkObject))};
        callExport("handleGeneratePhase", args, 3);
    } catch (const std::exception &exception) {
        logPluginError(exception.what());
    } catch (...) {
        logPluginError("Unknown Static Hermes chunk generation callback failure");
    }
}

void exports_pumpkin_plugin_metadata_get_metadata(
    exports_pumpkin_plugin_metadata_plugin_metadata_t *ret) {
    std::memset(ret, 0, sizeof(*ret));
    try {
        initializeRuntime();
        auto exports = exportsObject(*jsRuntime);
        auto metadata = exports.getPropertyAsObject(*jsRuntime, "metadata");
        auto value = metadata.getPropertyAsFunction(*jsRuntime, "getMetadata")
                         .call(*jsRuntime);
        auto object = value.asObject(*jsRuntime);
        copyString(&ret->name, *jsRuntime,
                   object.getProperty(*jsRuntime, "name"));
        copyString(&ret->version, *jsRuntime,
                   object.getProperty(*jsRuntime, "version"));
        copyString(&ret->description, *jsRuntime,
                   object.getProperty(*jsRuntime, "description"));
        copyStringList(&ret->authors, *jsRuntime,
                       object.getProperty(*jsRuntime, "authors"));
        copyStringList(&ret->dependencies, *jsRuntime,
                       object.getProperty(*jsRuntime, "dependencies"));
        copyStringList(&ret->permissions, *jsRuntime,
                       object.getProperty(*jsRuntime, "permissions"));
    } catch (const std::exception &exception) {
        useFallbackMetadata(ret, exception.what());
    } catch (...) {
        useFallbackMetadata(ret, "unknown exception");
    }
}

