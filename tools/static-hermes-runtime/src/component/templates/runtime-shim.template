bool exports_plugin_handle_ipc_message(plugin_plugin_id_t *sender,
                                       plugin_ipc_message_t *message,
                                       plugin_ipc_message_t *ret,
                                       plugin_string_t *error) {
    std::memset(ret, 0, sizeof(*ret));
    std::memset(error, 0, sizeof(*error));
    try {
        initializeRuntime();

        auto senderValue = jsString(*jsRuntime, wasiStringValue(*sender));
        Uint8Array messageValue(*jsRuntime, message->len);
        if (message->len > 0) {
            auto buffer = messageValue.buffer(*jsRuntime);
            std::memcpy(buffer.data(*jsRuntime), message->ptr, message->len);
        }

        Value args[] = {std::move(senderValue), std::move(messageValue)};
        auto response = callExport("handleIpcMessage", args, 2);
        auto responseBytes = response.asObject(*jsRuntime).asUint8Array(*jsRuntime);
        const auto responseLength = responseBytes.byteLength(*jsRuntime);
        uint8_t *ownedResponse = nullptr;
        if (responseLength > 0) {
            ownedResponse = static_cast<uint8_t *>(std::malloc(responseLength));
            if (!ownedResponse)
                throw std::runtime_error("Unable to allocate IPC response");
            auto buffer = responseBytes.buffer(*jsRuntime);
            std::memcpy(ownedResponse,
                        buffer.data(*jsRuntime) +
                            responseBytes.byteOffset(*jsRuntime),
                        responseLength);
        }
        ret->ptr = ownedResponse;
        ret->len = responseLength;
        return true;
    } catch (const std::exception &exception) {
        setError(error, exception.what());
        return false;
    } catch (...) {
        setError(error, "Unknown error while handling IPC message");
        return false;
    }
}

static std::shared_ptr<ResourceState> makeOwnedWitCallbackResource(
    int32_t handle, ResourceKind kind, const char *interfaceName,
    const char *resourceName) {
    return std::make_shared<ResourceState>(ResourceState{
        kind, handle, true, interfaceName, resourceName, ""});
}

static bool dispatchAiGoalCallback(
    const char *exportName, uint32_t goalId,
    plugin_own_server_instance_t server, plugin_own_entity_t entity,
    bool returnsBoolean) {
    std::shared_ptr<ResourceState> serverState;
    std::shared_ptr<ResourceState> entityState;
    WitScopeGuard resourceCleanup([&] {
        if (serverState)
            serverState->drop();
        else
            pumpkin_plugin_server_server_drop_own(
                pumpkin_plugin_server_own_server_t{server.__handle});
        if (entityState)
            entityState->drop();
        else
            pumpkin_plugin_world_entity_drop_own(
                pumpkin_plugin_world_own_entity_t{entity.__handle});
    });

    try {
        serverState = makeOwnedWitCallbackResource(
            server.__handle, ResourceKind::Server, "server", "server");
        entityState = makeOwnedWitCallbackResource(
            entity.__handle, ResourceKind::Entity, "world", "entity");
        auto serverObject = wrapResourceObject(
            *jsRuntime, std::make_shared<ServerObject>(serverState));
        auto entityObject = wrapResourceObject(
            *jsRuntime, makeWitResourceObject(entityState));
        Value args[] = {Value(static_cast<double>(goalId)),
                        Value(std::move(serverObject)),
                        Value(std::move(entityObject))};
        auto result = callExport(exportName, args, 3);
        return returnsBoolean ? result.getBool() : false;
    } catch (const std::exception &exception) {
        logPluginError(exception.what());
    } catch (...) {
        logPluginError("Unknown Static Hermes AI goal callback failure");
    }
    return false;
}

