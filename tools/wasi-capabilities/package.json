        "wasi",
        "webassembly",
        "capabilities"
    ],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins/tree/master/tools/wasi-capabilities#readme",
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "repository": {
        "type": "git",
