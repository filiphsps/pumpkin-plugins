{
    "name": "@pumpkin-plugins/update-check",
    "version": "0.1.3",
    "description": "Check plugin versions against Pumpkin Market",
    "keywords": [
        "minecraft",
        "pumpkin",
        "plugin",
        "updates",
        "version-check",
        "pumpkin-market"
    ],
    "homepage": "https://github.com/filiphsps/pumpkin-plugins/tree/master/tools/update-check#readme",
    "bugs": {
        "url": "https://github.com/filiphsps/pumpkin-plugins/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/filiphsps/pumpkin-plugins.git",
        "directory": "tools/update-check"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/filiphsps"
        },
        {
            "type": "custom",
            "url": "https://paypal.me/filiph"
        }
    ],
    "license": "MIT",
    "author": "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)",
    "contributors": [
        "Filiph Sandström <filfat@hotmail.se> (https://github.com/filiphsps)"
    ],
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "files": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts"
    ],
    "scripts": {
        "build": "pumpkin-plugins-build",
        "readme": "pumpkin-plugins-docs generate docs.ts",
        "readme:check": "pumpkin-plugins-docs generate docs.ts --check",
        "test": "vitest run --project unit",
        "test:coverage": "vitest run --project unit --coverage",
        "test:integration": "vitest run --project integration",
        "typecheck": "pnpm build --types-only && tsc --noEmit"
    },
    "dependencies": {
        "@pumpkin-plugins/docs": "workspace:*",
        "@pumpkin-plugins/pumpkin-api": "catalog:",
        "fflate": "catalog:",
        "remove-markdown": "0.7.0"
    },
    "devDependencies": {
        "@pumpkin-plugins/build": "workspace:*",
        "@pumpkin-plugins/test-harness": "workspace:*",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">=24.21.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "pumpkinPlugin": {
        "entry": "test/fixture-plugin.ts",
        "output": "build/update-check-fixture.wasm",
        "wasi": [
            "http"
        ]
    }
}
