{
    "extends": "../../tsconfig.templates.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "strict": true,
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": []
    },
    "include": ["build/types/bindings/**/*.d.ts", "src/**/*.js"]
}
