{
    "name": "__PLUGIN_NAME__",
    "version": "0.1.0",
    "private": true,
    "keywords": [
        "minecraft",
        "pumpkin",
        "plugin",
        "typescript",
        "template",
        "webassembly"
    ],
    "type": "module",
    "scripts": {
        "build": "pumpkin-plugins-build",
        "build:parse-ts": "pumpkin-plugins-build --parse-ts",
        "typecheck": "pumpkin-plugins-build --types-only && tsc --noEmit"
    },
    "dependencies": {
        "@pumpkin-plugins/build": "^0.1.1",
        "@pumpkin-plugins/pumpkin-api": "^0.1.0"
    },
    "devDependencies": {
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=24.21.0"
    },
    "pumpkinPlugin": {
        "entry": "src/plugin.ts",
        "output": "build/__PLUGIN_NAME__.wasm",
        "engine": "static-hermes",
        "wasi": []
    }
}
