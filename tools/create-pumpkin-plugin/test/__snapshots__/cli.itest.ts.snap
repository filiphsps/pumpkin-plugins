exports[`shows Commander help 1`] = `
"Usage: create-pumpkin-plugin [options] <directory>

Create a minimal standalone Pumpkin plugin project

Arguments:
  directory       project directory to create

Options:
  --ts            create the TypeScript starter
  --js            create the JavaScript starter
  --skip-install  write the project without installing dependencies
  -h, --help      display help for command
"
`;
